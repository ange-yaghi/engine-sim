import "engine_sim.mr"

units units()
constants constants()
impulse_response_library ir_lib()
bov_sound_library bov_lib()
label cycle(2 * 360 * units.deg)

// Nissan RB26DETT -- the twin-turbo 2.6L inline-6 out of the R32/R33/R34
// Skyline GT-R. Stock topology is a true parallel twin from the factory
// (unlike the 2JZ-GTE's sequential pair) -- each turbo is fed by its own
// bank of three cylinders via a genuinely split exhaust manifold, and both
// compressors dump into one shared plenum behind the individual throttle
// bodies, so this file's twin-turbo/shared-intake pattern models the real
// factory layout directly rather than approximating around a limitation.

private node wires {
    output wire1: ignition_wire();
    output wire2: ignition_wire();
    output wire3: ignition_wire();
    output wire4: ignition_wire();
    output wire5: ignition_wire();
    output wire6: ignition_wire();
}

private node rb_camshaft_builder {
    input lobe_profile;
    input intake_lobe_profile: lobe_profile;
    input exhaust_lobe_profile: lobe_profile;
    input lobe_separation: 114.0 * units.deg;
    input intake_lobe_center: lobe_separation;
    input exhaust_lobe_center: lobe_separation;
    input advance: 0.0 * units.deg;
    input base_radius: 0.75 * units.inch;

    output intake_cam: _intake_cam;
    output exhaust_cam: _exhaust_cam;

    camshaft_parameters params(
        advance: advance,
        base_radius: base_radius
    )

    camshaft _intake_cam(params, lobe_profile: intake_lobe_profile)
    camshaft _exhaust_cam(params, lobe_profile: exhaust_lobe_profile)

    label rot(2 * (360 / 6.0) * units.deg)
    label rot360(360 * units.deg)

    // Firing order 1-5-3-6-2-4
    _exhaust_cam
        .add_lobe((rot360 - exhaust_lobe_center) + 0 * rot)
        .add_lobe((rot360 - exhaust_lobe_center) + 4 * rot)
        .add_lobe((rot360 - exhaust_lobe_center) + 2 * rot)
        .add_lobe((rot360 - exhaust_lobe_center) + 5 * rot)
        .add_lobe((rot360 - exhaust_lobe_center) + 1 * rot)
        .add_lobe((rot360 - exhaust_lobe_center) + 3 * rot)

    _intake_cam
        .add_lobe(rot360 + intake_lobe_center + 0 * rot)
        .add_lobe(rot360 + intake_lobe_center + 4 * rot)
        .add_lobe(rot360 + intake_lobe_center + 2 * rot)
        .add_lobe(rot360 + intake_lobe_center + 5 * rot)
        .add_lobe(rot360 + intake_lobe_center + 1 * rot)
        .add_lobe(rot360 + intake_lobe_center + 3 * rot)
}

private node rb_ignition {
    input wires;
    input timing_curve;
    input rev_limit: 8000 * units.rpm;
    alias output __out:
        ignition_module(
            timing_curve: timing_curve,
            rev_limit: rev_limit,
            // Sharpest, most percussive cut in this batch -- the RB26's
            // famously abrupt rev-limiter bark, not a soft stutter.
            limiter_duration: 0.018
        )
            .connect_wire(wires.wire1, (0.0 / 6.0) * cycle)
            .connect_wire(wires.wire5, (1.0 / 6.0) * cycle)
            .connect_wire(wires.wire3, (2.0 / 6.0) * cycle)
            .connect_wire(wires.wire6, (3.0 / 6.0) * cycle)
            .connect_wire(wires.wire2, (4.0 / 6.0) * cycle)
            .connect_wire(wires.wire4, (5.0 / 6.0) * cycle);
}

private node rb_head {
    input intake_camshaft;
    input exhaust_camshaft;
    input chamber_volume: 42.0 * units.cc;
    input intake_runner_volume: 92.0 * units.cc;
    input intake_runner_cross_section_area: 1.35 * units.inch * 1.35 * units.inch;
    input exhaust_runner_volume: 40.0 * units.cc;
    input exhaust_runner_cross_section_area: 1.2 * units.inch * 1.2 * units.inch;

    input flow_attenuation: 1.0;
    input lift_scale: 1.0;
    input flip_display: false;
    alias output __out: head;

    function intake_flow(50 * units.thou)
    intake_flow
        .add_flow_sample(0 * lift_scale, 0 * flow_attenuation)
        .add_flow_sample(50 * lift_scale, 44 * flow_attenuation)
        .add_flow_sample(100 * lift_scale, 80 * flow_attenuation)
        .add_flow_sample(150 * lift_scale, 122 * flow_attenuation)
        .add_flow_sample(200 * lift_scale, 160 * flow_attenuation)
        .add_flow_sample(250 * lift_scale, 187 * flow_attenuation)
        .add_flow_sample(300 * lift_scale, 203 * flow_attenuation)
        .add_flow_sample(350 * lift_scale, 211 * flow_attenuation)
        .add_flow_sample(400 * lift_scale, 214 * flow_attenuation)
        .add_flow_sample(450 * lift_scale, 215 * flow_attenuation)

    function exhaust_flow(50 * units.thou)
    exhaust_flow
        .add_flow_sample(0 * lift_scale, 0 * flow_attenuation)
        .add_flow_sample(50 * lift_scale, 33 * flow_attenuation)
        .add_flow_sample(100 * lift_scale, 62 * flow_attenuation)
        .add_flow_sample(150 * lift_scale, 94 * flow_attenuation)
        .add_flow_sample(200 * lift_scale, 124 * flow_attenuation)
        .add_flow_sample(250 * lift_scale, 148 * flow_attenuation)
        .add_flow_sample(300 * lift_scale, 164 * flow_attenuation)
        .add_flow_sample(350 * lift_scale, 173 * flow_attenuation)
        .add_flow_sample(400 * lift_scale, 176 * flow_attenuation)
        .add_flow_sample(450 * lift_scale, 177 * flow_attenuation)

    generic_cylinder_head head(
        chamber_volume: chamber_volume,
        intake_runner_volume: intake_runner_volume,
        intake_runner_cross_section_area: intake_runner_cross_section_area,
        exhaust_runner_volume: exhaust_runner_volume,
        exhaust_runner_cross_section_area: exhaust_runner_cross_section_area,

        intake_port_flow: intake_flow,
        exhaust_port_flow: exhaust_flow,
        valvetrain: standard_valvetrain(
            intake_camshaft: intake_camshaft,
            exhaust_camshaft: exhaust_camshaft
        ),
        flip_display: flip_display
    )
}

public node rb26dett_na {
    output turbo_engine: engine;
    output turbo_intake: intake;
    output turbo_exhaust0: exhaust0;
    output turbo_exhaust1: exhaust1;

    wires wires()

    engine engine(
        name: "Nissan RB26DETT [Skyline GT-R, Twin Turbo]",
        starter_torque: 165 * units.lb_ft,
        starter_speed: 450 * units.rpm,
        redline: 8000 * units.rpm,
        fuel: fuel(
            max_turbulence_effect: 3.0,
            max_burning_efficiency: 0.85
        ),
        throttle_gamma: 2.0,
        // Rawest, most mechanical texture in this batch -- the RB26's
        // iconic gruff, slightly agricultural JDM turbo-six character
        // rather than a refined/muted one.
        hf_gain: 0.0062,
        noise: 0.52,
        jitter: 0.22,
        simulation_frequency: 16000
    )

    // 86.0mm x 73.7mm, 2568cc, 8.5:1 compression -- real RB26DETT dimensions
    // (deliberately undersquare/oversquare-adjacent bore/stroke, kept short
    // stroke for the high 8000rpm redline).
    label stroke(73.7 * units.mm)
    label bore(86.0 * units.mm)
    label rod_length(121.5 * units.mm)
    label rod_mass(500 * units.g)
    label compression_height(28.0 * units.mm)
    label crank_mass(15 * units.kg)
    label flywheel_mass(6.5 * units.kg)
    label flywheel_radius(6.0 * units.inch)

    label crank_moment(
        disk_moment_of_inertia(mass: crank_mass, radius: stroke / 2)
    )
    label flywheel_moment(
        disk_moment_of_inertia(mass: flywheel_mass, radius: flywheel_radius)
    )
    label other_moment(
        disk_moment_of_inertia(mass: 17 * units.kg, radius: 7.5 * units.cm)
    )

    crankshaft c0(
        throw: stroke / 2,
        flywheel_mass: flywheel_mass,
        mass: crank_mass,
        friction_torque: 6.5 * units.lb_ft,
        moment_of_inertia:
            crank_moment + flywheel_moment + other_moment,
        position_x: 0.0,
        position_y: 0.0,
        tdc: constants.pi / 2
    )

    // 1 5 3 6 2 4
    rod_journal rj0(angle: 0 * units.deg)
    rod_journal rj1(angle: 480 * units.deg)
    rod_journal rj2(angle: 240 * units.deg)
    rod_journal rj3(angle: 600 * units.deg)
    rod_journal rj4(angle: 120 * units.deg)
    rod_journal rj5(angle: 360 * units.deg)

    c0
        .add_rod_journal(rj0)
        .add_rod_journal(rj1)
        .add_rod_journal(rj2)
        .add_rod_journal(rj3)
        .add_rod_journal(rj4)
        .add_rod_journal(rj5)

    piston_parameters piston_params(
        mass: 300 * units.g,
        compression_height: compression_height,
        wrist_pin_position: 0.0,
        displacement: 0.0
    )

    connecting_rod_parameters cr_params(
        mass: rod_mass,
        moment_of_inertia: rod_moment_of_inertia(
            mass: rod_mass,
            length: rod_length
        ),
        center_of_mass: 0.0,
        length: rod_length
    )

    intake intake(
        plenum_volume: 1.2 * units.L,
        plenum_cross_section_area: 13.0 * units.cm2,
        intake_flow_rate: k_carb(600.0),
        runner_flow_rate: k_carb(210.0),
        runner_length: 7.0 * units.inch,
        idle_flow_rate: k_carb(0.0),
        // 0.9985 (0.15% open) settled just under the check tool's
        // running-floor threshold coming off the starter -- 0.998 gives
        // enough flow to hold a clean, realistic idle.
        idle_throttle_plate_position: 0.998,
        velocity_decay: 0.5
    )

    exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(900.0),
        // Shortest primary in this batch -- a sharper, higher-pitched
        // rasp instead of a deep resonant tone, matching the RB26's raw
        // tuner-culture reputation.
        primary_tube_length: 15.0 * units.inch,
        primary_flow_rate: k_carb(190.0),
        velocity_decay: 1.0,
        volume: 26.0 * units.L
    )

    // Genuine factory split: cylinders 1-3 (front bank) into their own
    // manifold/exhaust0 feeding the front turbo, cylinders 4-6 (rear bank)
    // into exhaust1 feeding the rear turbo -- a real contiguous split, not
    // an approximation.
    exhaust_system exhaust0(
        es_params,
        // Loudest, rawest voice in this batch -- sharp_0 for the RB26's
        // biting, unfiltered JDM twin-turbo character (distinct from the
        // BMW sixes' mild_exhaust variants and the 2JZ's smooth/muted one).
        audio_volume: 8 * 0.95,
        impulse_response: ir_lib.sharp_0
    )
    exhaust_system exhaust1(
        es_params,
        audio_volume: 8 * 1.15,
        impulse_response: ir_lib.sharp_0
    )

    cylinder_bank_parameters bank_params(
        bore: bore,
        deck_height: stroke / 2 + rod_length + compression_height
    )

    cylinder_bank b0(bank_params, angle: 0)
    b0
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire1,
            sound_attenuation: 0.9
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire2,
            sound_attenuation: 0.95
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire3,
            sound_attenuation: 0.9
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj3,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire4,
            sound_attenuation: 0.97
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj4,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire5,
            sound_attenuation: 0.98
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj5,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire6,
            sound_attenuation: 0.93
        )

    engine
        .add_cylinder_bank(b0)

    engine.add_crankshaft(c0)

    harmonic_cam_lobe intake_lobe(
        duration_at_50_thou: 226 * units.deg,
        gamma: 1.1,
        lift: 8.9 * units.mm,
        steps: 100
    )

    harmonic_cam_lobe exhaust_lobe(
        duration_at_50_thou: 222 * units.deg,
        gamma: 1.1,
        lift: 8.7 * units.mm,
        steps: 100
    )

    rb_camshaft_builder camshaft(
        lobe_profile: "N/A",
        intake_lobe_profile: intake_lobe,
        exhaust_lobe_profile: exhaust_lobe,
        intake_lobe_center: 114 * units.deg,
        exhaust_lobe_center: 114 * units.deg,
        base_radius: 0.75 * units.inch
    )

    b0.set_cylinder_head(
        rb_head(
            intake_camshaft: camshaft.intake_cam,
            exhaust_camshaft: camshaft.exhaust_cam
        )
    )

    function timing_curve(1000 * units.rpm)
    timing_curve
        .add_sample(0000 * units.rpm, 10 * units.deg)
        .add_sample(1000 * units.rpm, 14 * units.deg)
        .add_sample(2000 * units.rpm, 18 * units.deg)
        .add_sample(3000 * units.rpm, 22 * units.deg)
        .add_sample(4000 * units.rpm, 24 * units.deg)
        .add_sample(5000 * units.rpm, 24 * units.deg)
        .add_sample(6000 * units.rpm, 22 * units.deg)
        .add_sample(7000 * units.rpm, 20 * units.deg)
        .add_sample(8000 * units.rpm, 18 * units.deg)

    engine.add_ignition_module(
        rb_ignition(
            wires: wires,
            timing_curve: timing_curve,
            rev_limit: 8100 * units.rpm
        )
    )
}

private node rb26dett_twin_turbo {
    alias output __out: base.turbo_engine;

    rb26dett_na base()

    // Twin ceramic-wheel turbos (period-correct sizing for the stock
    // dual-turbo layout) -- each fed by only its own bank's exhaust
    // system, both compressors merging into the shared intake plenum.
    turbocharger turbo_front(
        intake: base.turbo_intake,
        turbine_flow_rate: k_carb(135.0),
        turbine_inertia: 0.000038,
        turbine_efficiency: 0.65,
        compressor_efficiency: 0.70,
        max_boost: 11.0 * units.psi,
        spool_speed: 165000.0 * units.rpm,
        bov_sound: bov_lib.bovaftermarket4
    )
    turbo_front.add_exhaust_system(base.turbo_exhaust0)

    turbocharger turbo_rear(
        intake: base.turbo_intake,
        turbine_flow_rate: k_carb(135.0),
        turbine_inertia: 0.000038,
        turbine_efficiency: 0.65,
        compressor_efficiency: 0.70,
        max_boost: 11.0 * units.psi,
        spool_speed: 165000.0 * units.rpm,
        bov_sound: bov_lib.bovaftermarket4
    )
    turbo_rear.add_exhaust_system(base.turbo_exhaust1)

    base.turbo_engine
        .add_turbocharger(turbo_front)
        .add_turbocharger(turbo_rear)
}

// AWD ATTESA E-TS Skyline GT-R (R32/R33-era curb weight) -- noticeably
// heavier and higher rolling resistance than a RWD-only equivalent because
// of the transfer case/front driveshaft/front diff, differentiated from
// the RWD RB25DET/Supra profiles in this batch.
private node rb26dett_vehicle {
    alias output __out:
        vehicle(
            mass: 3400 * units.lb,
            drag_coefficient: 0.35,
            cross_sectional_area: (69 * units.inch) * (53 * units.inch),
            diff_ratio: 4.111,
            tire_radius: 12.0 * units.inch,
            rolling_resistance: 460 * units.N
        );
}

// 5-speed Getrag manual (R32/R33 GT-R). Real stock ratios.
private node rb26dett_transmission {
    alias output __out:
        transmission(
            max_clutch_torque: 400 * units.lb_ft
        )
        .add_gear(3.827)
        .add_gear(2.360)
        .add_gear(1.685)
        .add_gear(1.312)
        .add_gear(1.000);
}

public node main {
    set_engine(rb26dett_twin_turbo())
    set_vehicle(rb26dett_vehicle())
    set_transmission(rb26dett_transmission())
}
