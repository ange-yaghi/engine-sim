import "engine_sim.mr"

units units()
constants constants()
impulse_response_library ir_lib()
label cycle(2 * 360 * units.deg)

// Nissan VQ35HR -- 3.5L NA DOHC 60 deg V6 (24 valve), as fitted to the
// 2007-2008 Infiniti G35 Sedan (V36). The "HR" revision over the earlier
// VQ35DE lightened the rotating assembly and revised the heads/intake
// plumbing for a higher (~7500rpm) redline at the same 95.5x81.4mm
// bore/stroke. RWD, longitudinal, paired here with the factory FS6R31A
// 6-speed manual offered on the G35 Sedan 6MT.

private node wires {
    output wire1: ignition_wire();
    output wire2: ignition_wire();
    output wire3: ignition_wire();
    output wire4: ignition_wire();
    output wire5: ignition_wire();
    output wire6: ignition_wire();
}

private node vq35hr_camshaft_builder {
    input lobe_profile;
    input intake_lobe_profile: lobe_profile;
    input exhaust_lobe_profile: lobe_profile;
    input lobe_separation: 114 * units.deg;
    input intake_lobe_center: lobe_separation;
    input exhaust_lobe_center: lobe_separation;
    input advance: 0 * units.deg;
    input base_radius: 0.75 * units.inch;

    output intake_cam_0: _intake_cam_0;
    output exhaust_cam_0: _exhaust_cam_0;

    output intake_cam_1: _intake_cam_1;
    output exhaust_cam_1: _exhaust_cam_1;

    // Nissan CVTCS -- continuously variable intake cam timing only (the
    // VQ35HR's exhaust cams are fixed, like the rest of the VQ family).
    // Curve shape/authority approximated, not from a factory VVT map.
    function intake_vvt(1000 * units.rpm)
    intake_vvt
        .add_sample(0000 * units.rpm, 0 * units.deg)
        .add_sample(1500 * units.rpm, 10 * units.deg)
        .add_sample(3500 * units.rpm, 20 * units.deg)
        .add_sample(5500 * units.rpm, 12 * units.deg)
        .add_sample(7500 * units.rpm, 6 * units.deg)

    camshaft_parameters params(
        advance: advance,
        base_radius: base_radius
    )

    camshaft _intake_cam_0(params, lobe_profile: intake_lobe_profile, advance_curve: intake_vvt)
    camshaft _exhaust_cam_0(params, lobe_profile: exhaust_lobe_profile)
    camshaft _intake_cam_1(params, lobe_profile: intake_lobe_profile, advance_curve: intake_vvt)
    camshaft _exhaust_cam_1(params, lobe_profile: exhaust_lobe_profile)

    label rot360(360 * units.deg)

    // Bank 0 = cylinders 1-3-5 (rod journals rj0/rj2/rj4 @ 0/240/120 deg).
    _exhaust_cam_0
        .add_lobe(rot360 - exhaust_lobe_center + 0 * units.deg)
        .add_lobe(rot360 - exhaust_lobe_center + 240 * units.deg)
        .add_lobe(rot360 - exhaust_lobe_center + 480 * units.deg)
    _intake_cam_0
        .add_lobe(rot360 + intake_lobe_center + 0 * units.deg)
        .add_lobe(rot360 + intake_lobe_center + 240 * units.deg)
        .add_lobe(rot360 + intake_lobe_center + 480 * units.deg)

    // Bank 1 = cylinders 2-4-6 (rod journals rj1/rj3/rj5 @ 60/300/180 deg).
    _exhaust_cam_1
        .add_lobe(rot360 - exhaust_lobe_center + 120 * units.deg)
        .add_lobe(rot360 - exhaust_lobe_center + 360 * units.deg)
        .add_lobe(rot360 - exhaust_lobe_center + 600 * units.deg)
    _intake_cam_1
        .add_lobe(rot360 + intake_lobe_center + 120 * units.deg)
        .add_lobe(rot360 + intake_lobe_center + 360 * units.deg)
        .add_lobe(rot360 + intake_lobe_center + 600 * units.deg)
}

private node vq35hr_head {
    input intake_camshaft;
    input exhaust_camshaft;
    // Chamber volume picked to land the ~10.6:1 compression given the
    // 95.5x81.4mm bore/stroke below: swept vol/cyl = (pi/4)*95.5mm^2*81.4mm
    // =~ 583.1cc; (583.1 + 60.7) / 60.7 =~ 10.6:1.
    input chamber_volume: 60.7 * units.cc;
    input intake_runner_volume: 158.0 * units.cc;
    input intake_runner_cross_section_area: 1.4 * units.inch * 1.4 * units.inch;
    input exhaust_runner_volume: 55.0 * units.cc;
    input exhaust_runner_cross_section_area: 1.25 * units.inch * 1.25 * units.inch;

    input flow_attenuation: 1.0;
    input lift_scale: 1.0;
    input flip_display: false;
    alias output __out: head;

    // Approximated flow-bench numbers for the 4-valve DOHC VQ35HR head --
    // not from a real flow bench; scaled up from a similar-swept-volume
    // generic V6 head to reflect the HR head's bigger valves/revised ports
    // relative to the earlier VQ35DE.
    function intake_flow(50 * units.thou)
    intake_flow
        .add_flow_sample(0 * lift_scale, 0 * flow_attenuation)
        .add_flow_sample(50 * lift_scale, 66 * flow_attenuation)
        .add_flow_sample(100 * lift_scale, 118 * flow_attenuation)
        .add_flow_sample(150 * lift_scale, 178 * flow_attenuation)
        .add_flow_sample(200 * lift_scale, 244 * flow_attenuation)
        .add_flow_sample(250 * lift_scale, 285 * flow_attenuation)
        .add_flow_sample(300 * lift_scale, 307 * flow_attenuation)
        .add_flow_sample(350 * lift_scale, 321 * flow_attenuation)
        .add_flow_sample(400 * lift_scale, 322 * flow_attenuation)
        .add_flow_sample(450 * lift_scale, 323 * flow_attenuation)

    function exhaust_flow(50 * units.thou)
    exhaust_flow
        .add_flow_sample(0 * lift_scale, 0 * flow_attenuation)
        .add_flow_sample(50 * lift_scale, 42 * flow_attenuation)
        .add_flow_sample(100 * lift_scale, 82 * flow_attenuation)
        .add_flow_sample(150 * lift_scale, 129 * flow_attenuation)
        .add_flow_sample(200 * lift_scale, 181 * flow_attenuation)
        .add_flow_sample(250 * lift_scale, 222 * flow_attenuation)
        .add_flow_sample(300 * lift_scale, 252 * flow_attenuation)
        .add_flow_sample(350 * lift_scale, 267 * flow_attenuation)
        .add_flow_sample(400 * lift_scale, 278 * flow_attenuation)
        .add_flow_sample(450 * lift_scale, 279 * flow_attenuation)

    generic_cylinder_head head(
        chamber_volume: chamber_volume,
        intake_runner_volume: intake_runner_volume,
        intake_runner_cross_section_area: intake_runner_cross_section_area,
        exhaust_runner_volume: exhaust_runner_volume,
        exhaust_runner_cross_section_area: exhaust_runner_cross_section_area,

        intake_port_flow: intake_flow,
        exhaust_port_flow: exhaust_flow,
        valvetrain: standard_valvetrain(
            intake_camshaft: intake_camshaft,
            exhaust_camshaft: exhaust_camshaft
        ),
        flip_display: flip_display
    )
}

public node vq35hr_v6 {
    alias output __out: engine;

    engine engine(
        name: "Nissan VQ35HR [G35 Sedan, 6MT]",
        starter_torque: 160 * units.lb_ft,
        starter_speed: 450 * units.rpm,
        redline: 7500 * units.rpm,
        fuel: fuel(
            max_turbulence_effect: 2.7,
            max_burning_efficiency: 0.86
        ),
        throttle_gamma: 2.0,
        hf_gain: 0.0025,
        noise: 0.28,
        jitter: 0.16,
        simulation_frequency: 18000
    )

    wires wires()

    // 95.5mm x 81.4mm, 3498cc -- real VQ35HR dimensions (same bore/stroke
    // as the VQ35DE it's based on; the HR revision's changes -- lighter
    // pistons/rods, revised heads and intake plumbing, higher redline --
    // are internal, not bore/stroke). ~10.6:1 compression.
    label stroke(81.4 * units.mm)
    label bore(95.5 * units.mm)
    label rod_length(146.0 * units.mm) // approximated, not from spec
    label rod_mass(460 * units.g) // approximated, not from spec
    label compression_height(27.0 * units.mm) // approximated, not from spec
    label crank_mass(14 * units.kg) // approximated -- HR's lightened forged crank
    label flywheel_mass(8.5 * units.kg) // approximated -- single-mass 6MT flywheel
    label flywheel_radius(5.7 * units.inch) // approximated

    label crank_moment(
        disk_moment_of_inertia(mass: crank_mass, radius: stroke / 2)
    )
    label flywheel_moment(
        disk_moment_of_inertia(mass: flywheel_mass, radius: flywheel_radius)
    )
    label other_moment( // Moment from 4 camshafts, chains, pulleys, etc [estimated]
        disk_moment_of_inertia(mass: 16 * units.kg, radius: 7.5 * units.cm)
    )

    crankshaft c0(
        throw: stroke / 2,
        flywheel_mass: flywheel_mass,
        mass: crank_mass,
        friction_torque: 7.0 * units.lb_ft,
        moment_of_inertia:
            crank_moment + flywheel_moment + other_moment,
        position_x: 0.0,
        position_y: 0.0,
        tdc: (90 + 30) * units.deg
    )

    // Single-plane crank: 3 throws, 120 deg apart, each throw shared by one
    // cylinder from each bank. 60 deg bank angle == throw spacing / 2, so
    // (unlike a 90 deg V6) no split-pin offset is needed for even firing --
    // each rod journal pair sharing a throw is simply offset by the bank
    // angle itself (60 deg), matching the real VQ crank's plain shared-pin
    // design. See angethegreat/atg-video-2/04_60_degree_v6.mr, whose
    // crank/journal geometry this mirrors exactly.
    rod_journal rj0(angle: 0.0 * units.deg)
    rod_journal rj1(angle: (0.0 + 60) * units.deg)
    rod_journal rj2(angle: 240.0 * units.deg)
    rod_journal rj3(angle: (240.0 + 60) * units.deg)
    rod_journal rj4(angle: 120.0 * units.deg)
    rod_journal rj5(angle: (120.0 + 60) * units.deg)
    c0
        .add_rod_journal(rj0)
        .add_rod_journal(rj1)
        .add_rod_journal(rj2)
        .add_rod_journal(rj3)
        .add_rod_journal(rj4)
        .add_rod_journal(rj5)

    piston_parameters piston_params(
        mass: 410 * units.g, // approximated, not from spec
        compression_height: compression_height,
        wrist_pin_position: 0.0,
        displacement: 0.0
    )

    connecting_rod_parameters cr_params(
        mass: rod_mass,
        moment_of_inertia: rod_moment_of_inertia(
            mass: rod_mass,
            length: rod_length
        ),
        center_of_mass: 0.0,
        length: rod_length
    )

    intake intake(
        plenum_volume: 2.0 * units.L,
        plenum_cross_section_area: 24.0 * units.cm2,
        intake_flow_rate: k_carb(700.0),
        runner_flow_rate: k_carb(285.0),
        runner_length: 9.0 * units.inch,
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 0.997,
        velocity_decay: 0.5
    )

    exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(1000.0),
        primary_tube_length: 20.0 * units.inch,
        primary_flow_rate: k_carb(285.0),
        velocity_decay: 1.0,
        volume: 30.0 * units.L
    )

    // Dual exhaust -- each bank into its own manifold/cat/muffler, matching
    // the real G35's factory dual exhaust layout.
    exhaust_system exhaust0(
        es_params,
        audio_volume: 1.0,
        impulse_response: ir_lib.mild_exhaust_0
    )
    exhaust_system exhaust1(
        es_params,
        audio_volume: 1.0,
        impulse_response: ir_lib.mild_exhaust_0
    )

    cylinder_bank_parameters bank_params(
        bore: bore,
        deck_height: stroke / 2 + rod_length + compression_height
    )

    label spacing(4.4 * units.inch) // approximated bore-pitch spacing

    cylinder_bank b0(bank_params, angle: 30.0 * units.deg)
    cylinder_bank b1(bank_params, angle: -30.0 * units.deg)
    b0
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire1,
            sound_attenuation: 0.9,
            primary_length: spacing * 2
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire3,
            sound_attenuation: 0.95,
            primary_length: spacing * 1
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj4,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire5,
            sound_attenuation: 1.0,
            primary_length: spacing * 0
        )
        .set_cylinder_head(
            vq35hr_head(
                flip_display: true,
                intake_camshaft: camshaft.intake_cam_0,
                exhaust_camshaft: camshaft.exhaust_cam_0)
        )
    b1
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire2,
            sound_attenuation: 0.95,
            primary_length: spacing * 2
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj3,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire4,
            sound_attenuation: 0.9,
            primary_length: spacing * 1
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj5,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire6,
            sound_attenuation: 1.0,
            primary_length: spacing * 0
        )
        .set_cylinder_head(
            vq35hr_head(
                intake_camshaft: camshaft.intake_cam_1,
                exhaust_camshaft: camshaft.exhaust_cam_1,
                flip_display: false)
        )

    engine
        .add_cylinder_bank(b0)
        .add_cylinder_bank(b1)

    engine.add_crankshaft(c0)

    harmonic_cam_lobe intake_lobe(
        duration_at_50_thou: 222 * units.deg,
        gamma: 1.05,
        lift: 9.7 * units.mm, // approximated, not from spec
        steps: 100
    )

    harmonic_cam_lobe exhaust_lobe(
        duration_at_50_thou: 214 * units.deg,
        gamma: 1.05,
        lift: 9.3 * units.mm, // approximated, not from spec
        steps: 100
    )

    vq35hr_camshaft_builder camshaft(
        lobe_profile: "N/A",
        intake_lobe_profile: intake_lobe,
        exhaust_lobe_profile: exhaust_lobe,
        intake_lobe_center: 117 * units.deg,
        exhaust_lobe_center: 112 * units.deg,
        base_radius: 0.75 * units.inch
    )

    function timing_curve(1000 * units.rpm)
    timing_curve
        .add_sample(0000 * units.rpm, 10 * units.deg)
        .add_sample(1000 * units.rpm, 15 * units.deg)
        .add_sample(2000 * units.rpm, 20 * units.deg)
        .add_sample(3000 * units.rpm, 24 * units.deg)
        .add_sample(4000 * units.rpm, 27 * units.deg)
        .add_sample(5000 * units.rpm, 29 * units.deg)
        .add_sample(6000 * units.rpm, 29 * units.deg)
        .add_sample(7000 * units.rpm, 27 * units.deg)

    // Firing order 1-2-3-4-5-6, alternating banks every event -- the
    // correct even-fire order for this 60 deg single-plane crank (bank 0 =
    // cylinders 1-3-5 on rj0/rj2/rj4 @ 0/240/120 deg; bank 1 = cylinders
    // 2-4-6 on rj1/rj3/rj5 @ 60/300/180 deg). Wiring wire1..wire6 to
    // successive 120 deg slots visits bank0,bank1,bank0,bank1,bank0,bank1
    // -- every event exactly 120 deg apart, matching Nissan's documented
    // VQ35 firing order and cylinder-bank numbering (bank 1 = 1-3-5, bank 2
    // = 2-4-6).
    ignition_module ignition_module(
        timing_curve: timing_curve,
        rev_limit: 7600 * units.rpm,
        limiter_duration: 0.03
    )
    ignition_module
        .connect_wire(wires.wire1, 0 * units.deg)
        .connect_wire(wires.wire2, 120 * units.deg)
        .connect_wire(wires.wire3, 240 * units.deg)
        .connect_wire(wires.wire4, 360 * units.deg)
        .connect_wire(wires.wire5, 480 * units.deg)
        .connect_wire(wires.wire6, 600 * units.deg)

    engine.add_ignition_module(ignition_module)
}

// 2007-2008 Infiniti G35 Sedan (V36), 6MT curb weight/aero.
private node vq35hr_vehicle {
    alias output __out:
        vehicle(
            mass: 3450 * units.lb,
            drag_coefficient: 0.30,
            cross_sectional_area: (70 * units.inch) * (56 * units.inch),
            diff_ratio: 3.538,
            tire_radius: 12.4 * units.inch,
            rolling_resistance: 380 * units.N
        );
}

// FS6R31A 6-speed manual -- real-world-plausible G35/350Z-family close
// ratio set (not VIN-specific, but representative of this car's 6MT).
private node vq35hr_transmission {
    alias output __out:
        transmission(
            max_clutch_torque: 320 * units.lb_ft,
            type: "manual"
        )
        .add_gear(3.795)
        .add_gear(2.267)
        .add_gear(1.641)
        .add_gear(1.253)
        .add_gear(1.000)
        .add_gear(0.794);
}

public node main {
    set_engine(vq35hr_v6())
    set_vehicle(vq35hr_vehicle())
    set_transmission(vq35hr_transmission())
}
