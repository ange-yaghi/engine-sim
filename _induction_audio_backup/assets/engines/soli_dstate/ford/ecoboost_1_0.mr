import "engine_sim.mr"

units units()
constants constants()
impulse_response_library ir_lib()
bov_sound_library bov_lib()
label cycle(2 * 360 * units.deg)

// Ford 1.0L EcoBoost -- the tiny turbocharged inline-3 out of the Mk3/Mk3.5
// Focus. Real production three-cylinders run a 120-degree crank (each
// cylinder gets its own throw, unlike a paired inline-4 layout), which
// naturally gives perfectly even 240-degree firing intervals -- modeled
// here at 140PS/180lb-ft, the higher of the two common Focus tunes.

private node wires {
    output wire1: ignition_wire();
    output wire2: ignition_wire();
    output wire3: ignition_wire();
}

private node eb10_camshaft_builder {
    input lobe_profile;
    input intake_lobe_profile: lobe_profile;
    input exhaust_lobe_profile: lobe_profile;
    input lobe_separation: 112 * units.deg;
    input intake_lobe_center: lobe_separation;
    input exhaust_lobe_center: lobe_separation;
    input advance: 0 * units.deg;
    input base_radius: 15.0 * units.mm;

    output intake_cam: _intake_cam;
    output exhaust_cam: _exhaust_cam;

    camshaft_parameters params(
        advance: advance,
        base_radius: base_radius
    )

    // Ti-VCT -- twin independent cam phasing (both intake and exhaust).
    function intake_vvt(1000 * units.rpm)
    intake_vvt
        .add_sample(0000 * units.rpm, 0 * units.deg)
        .add_sample(1500 * units.rpm, 12 * units.deg)
        .add_sample(3500 * units.rpm, 16 * units.deg)
        .add_sample(6500 * units.rpm, 8 * units.deg)

    function exhaust_vvt(1000 * units.rpm)
    exhaust_vvt
        .add_sample(0000 * units.rpm, 0 * units.deg)
        .add_sample(2000 * units.rpm, 8 * units.deg)
        .add_sample(6500 * units.rpm, 10 * units.deg)

    camshaft _intake_cam(params, lobe_profile: intake_lobe_profile, advance_curve: intake_vvt)
    camshaft _exhaust_cam(params, lobe_profile: exhaust_lobe_profile, advance_curve: exhaust_vvt)

    label rot360(360 * units.deg)
    label rot(2 * (360 / 3.0) * units.deg)

    // Firing order 1-2-3 (sequential -- even 240deg spacing)
    _exhaust_cam
        .add_lobe((rot360 - exhaust_lobe_center) + 0 * rot)
        .add_lobe((rot360 - exhaust_lobe_center) + 1 * rot)
        .add_lobe((rot360 - exhaust_lobe_center) + 2 * rot)
    _intake_cam
        .add_lobe((rot360 + intake_lobe_center) + 0 * rot)
        .add_lobe((rot360 + intake_lobe_center) + 1 * rot)
        .add_lobe((rot360 + intake_lobe_center) + 2 * rot)
}

private node eb10_head {
    input intake_camshaft;
    input exhaust_camshaft;
    input chamber_volume: 33.0 * units.cc;
    input intake_runner_volume: 63.0 * units.cc;
    input intake_runner_cross_section_area: 1.0 * units.inch * 1.0 * units.inch;
    input exhaust_runner_volume: 28.0 * units.cc;
    input exhaust_runner_cross_section_area: 0.9 * units.inch * 0.9 * units.inch;

    input flow_attenuation: 1.0;
    input lift_scale: 1.0;
    input flip_display: false;
    alias output __out: head;

    function intake_flow(50 * units.thou)
    intake_flow
        .add_flow_sample(0 * lift_scale, 0 * flow_attenuation)
        .add_flow_sample(50 * lift_scale, 37 * flow_attenuation)
        .add_flow_sample(100 * lift_scale, 66 * flow_attenuation)
        .add_flow_sample(150 * lift_scale, 99 * flow_attenuation)
        .add_flow_sample(200 * lift_scale, 130 * flow_attenuation)
        .add_flow_sample(250 * lift_scale, 153 * flow_attenuation)
        .add_flow_sample(300 * lift_scale, 166 * flow_attenuation)
        .add_flow_sample(350 * lift_scale, 173 * flow_attenuation)
        .add_flow_sample(400 * lift_scale, 176 * flow_attenuation)
        .add_flow_sample(450 * lift_scale, 177 * flow_attenuation)

    function exhaust_flow(50 * units.thou)
    exhaust_flow
        .add_flow_sample(0 * lift_scale, 0 * flow_attenuation)
        .add_flow_sample(50 * lift_scale, 29 * flow_attenuation)
        .add_flow_sample(100 * lift_scale, 53 * flow_attenuation)
        .add_flow_sample(150 * lift_scale, 81 * flow_attenuation)
        .add_flow_sample(200 * lift_scale, 106 * flow_attenuation)
        .add_flow_sample(250 * lift_scale, 125 * flow_attenuation)
        .add_flow_sample(300 * lift_scale, 137 * flow_attenuation)
        .add_flow_sample(350 * lift_scale, 143 * flow_attenuation)
        .add_flow_sample(400 * lift_scale, 146 * flow_attenuation)
        .add_flow_sample(450 * lift_scale, 147 * flow_attenuation)

    generic_cylinder_head head(
        chamber_volume: chamber_volume,
        intake_runner_volume: intake_runner_volume,
        intake_runner_cross_section_area: intake_runner_cross_section_area,
        exhaust_runner_volume: exhaust_runner_volume,
        exhaust_runner_cross_section_area: exhaust_runner_cross_section_area,

        intake_port_flow: intake_flow,
        exhaust_port_flow: exhaust_flow,
        valvetrain: standard_valvetrain(
            intake_camshaft: intake_camshaft,
            exhaust_camshaft: exhaust_camshaft
        ),
        flip_display: flip_display
    )
}

public node eb10_na {
    output turbo_engine: engine;
    output turbo_intake: intake;
    output turbo_exhaust0: exhaust0;

    wires wires()

    engine engine(
        name: "Ford 1.0L EcoBoost [Focus, Turbo I3]",
        starter_torque: 35 * units.lb_ft,
        starter_speed: 400 * units.rpm,
        redline: 6500 * units.rpm,
        fuel: fuel(
            max_turbulence_effect: 3.0,
            max_burning_efficiency: 0.82
        ),
        throttle_gamma: 2.0,
        hf_gain: 0.0038,
        noise: 0.3,
        jitter: 0.18,
        simulation_frequency: 18000
    )

    // 71.9mm x 82.0mm, 999cc, ~10.0:1 compression -- real 1.0L EcoBoost
    // (Fox/Dragon) dimensions.
    label stroke(82.0 * units.mm)
    label bore(71.9 * units.mm)
    label rod_length(132.0 * units.mm)
    label rod_mass(340 * units.g)
    label compression_height(25.0 * units.mm)
    label crank_mass(9 * units.kg)
    label flywheel_mass(6 * units.kg)
    label flywheel_radius(5.5 * units.inch)

    label crank_moment(
        disk_moment_of_inertia(mass: crank_mass, radius: stroke / 2)
    )
    label flywheel_moment(
        disk_moment_of_inertia(mass: flywheel_mass, radius: flywheel_radius)
    )
    label other_moment(
        disk_moment_of_inertia(mass: 5 * units.kg, radius: 5.5 * units.cm)
    )

    crankshaft c0(
        throw: stroke / 2,
        flywheel_mass: flywheel_mass,
        mass: crank_mass,
        friction_torque: 2.2 * units.lb_ft,
        moment_of_inertia:
            crank_moment + flywheel_moment + other_moment,
        position_x: 0.0,
        position_y: 0.0,
        tdc: 90 * units.deg
    )

    // 120-degree crank -- one throw per cylinder, even 240deg firing.
    rod_journal rj0(angle: 0.0 * units.deg)
    rod_journal rj1(angle: 240.0 * units.deg)
    rod_journal rj2(angle: 480.0 * units.deg)
    c0
        .add_rod_journal(rj0)
        .add_rod_journal(rj1)
        .add_rod_journal(rj2)

    piston_parameters piston_params(
        mass: 260 * units.g,
        compression_height: compression_height,
        wrist_pin_position: 0.0,
        displacement: 0.0
    )

    connecting_rod_parameters cr_params(
        mass: rod_mass,
        moment_of_inertia: rod_moment_of_inertia(
            mass: rod_mass,
            length: rod_length
        ),
        center_of_mass: 0.0,
        length: rod_length
    )

    intake intake(
        plenum_volume: 0.7 * units.L,
        plenum_cross_section_area: 8.0 * units.cm2,
        intake_flow_rate: k_carb(380.0),
        runner_flow_rate: k_carb(140.0),
        runner_length: 6.0 * units.inch,
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 0.998,
        velocity_decay: 0.5
    )

    // Compact 3-into-1 log manifold cast into the head -- real 1.0
    // EcoBoost integrates the exhaust manifold, so a single shared runner
    // feeding the turbo (rather than a split pair) matches the real part.
    exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(420.0),
        primary_tube_length: 14.0 * units.inch,
        primary_flow_rate: k_carb(100.0),
        velocity_decay: 1.0,
        volume: 10.0 * units.L
    )

    exhaust_system exhaust0(
        es_params,
        audio_volume: 8 * 0.9,
        impulse_response: ir_lib.mild_exhaust_0
    )

    cylinder_bank_parameters bank_params(
        bore: bore,
        deck_height: stroke / 2 + rod_length + compression_height
    )

    cylinder_bank b0(bank_params, angle: 0.0 * units.deg)
    b0
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire1,
            sound_attenuation: 0.9
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire2,
            sound_attenuation: 1.0
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire3,
            sound_attenuation: 0.9
        )

    engine
        .add_cylinder_bank(b0)

    engine.add_crankshaft(c0)

    harmonic_cam_lobe intake_lobe(
        duration_at_50_thou: 200 * units.deg,
        gamma: 1.05,
        lift: 8.6 * units.mm,
        steps: 100
    )

    harmonic_cam_lobe exhaust_lobe(
        duration_at_50_thou: 196 * units.deg,
        gamma: 1.05,
        lift: 8.2 * units.mm,
        steps: 100
    )

    eb10_camshaft_builder camshaft(
        lobe_profile: "N/A",
        intake_lobe_profile: intake_lobe,
        exhaust_lobe_profile: exhaust_lobe,
        intake_lobe_center: 112 * units.deg,
        exhaust_lobe_center: 112 * units.deg,
        base_radius: 15.0 * units.mm
    )

    b0.set_cylinder_head(
        eb10_head(
            intake_camshaft: camshaft.intake_cam,
            exhaust_camshaft: camshaft.exhaust_cam
        )
    )

    function timing_curve(1000 * units.rpm)
    timing_curve
        .add_sample(0000 * units.rpm, 10 * units.deg)
        .add_sample(1000 * units.rpm, 14 * units.deg)
        .add_sample(2000 * units.rpm, 18 * units.deg)
        .add_sample(3000 * units.rpm, 20 * units.deg)
        .add_sample(4000 * units.rpm, 20 * units.deg)
        .add_sample(5000 * units.rpm, 18 * units.deg)
        .add_sample(6000 * units.rpm, 16 * units.deg)
        .add_sample(6500 * units.rpm, 14 * units.deg)

    ignition_module ignition_module(
        timing_curve: timing_curve,
        rev_limit: 6700 * units.rpm,
        limiter_duration: 0.03
    )
    ignition_module
        .connect_wire(wires.wire1, (0.0 / 3.0) * cycle)
        .connect_wire(wires.wire2, (1.0 / 3.0) * cycle)
        .connect_wire(wires.wire3, (2.0 / 3.0) * cycle)

    engine.add_ignition_module(ignition_module)
}

// Small single-scroll turbo -- period-correct sizing for the "140PS"
// (103kW/180lb-ft) Focus tune.
private node eb10_turbo {
    alias output __out: base.turbo_engine;

    eb10_na base()

    turbocharger turbo(
        intake: base.turbo_intake,
        turbine_flow_rate: k_carb(95.0),
        turbine_inertia: 0.00002,
        turbine_efficiency: 0.66,
        compressor_efficiency: 0.72,
        max_boost: 24.0 * units.psi,
        spool_speed: 195000.0 * units.rpm,
        bov_sound: bov_lib.bovstock3
    )
    turbo.add_exhaust_system(base.turbo_exhaust0)

    base.turbo_engine.add_turbocharger(turbo)
}

// Mk3.5 Focus 5-door hatchback, manual.
private node eb10_vehicle {
    alias output __out:
        vehicle(
            mass: 2900 * units.lb,
            drag_coefficient: 0.295,
            cross_sectional_area: (68 * units.inch) * (54 * units.inch),
            diff_ratio: 3.94,
            tire_radius: 11.5 * units.inch,
            rolling_resistance: 350 * units.N
        );
}

// 6-speed B6 manual (small-engine Focus final drive/ratio set). Approximate
// published ratios.
private node eb10_transmission {
    alias output __out:
        transmission(
            max_clutch_torque: 200 * units.lb_ft,
            type: "manual"
        )
        .add_gear(3.769)
        .add_gear(2.045)
        .add_gear(1.343)
        .add_gear(0.973)
        .add_gear(0.762)
        .add_gear(0.634);
}

public node main {
    set_engine(eb10_turbo())
    set_vehicle(eb10_vehicle())
    set_transmission(eb10_transmission())
}
