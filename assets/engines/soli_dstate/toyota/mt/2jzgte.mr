import "engine_sim.mr"

units units()
constants constants()
impulse_response_library ir_lib()
bov_sound_library bov_lib()
label cycle(2 * 360 * units.deg)

// Toyota 2JZ-GTE -- the twin-turbo 3.0L inline-6 out of the JZA80 Supra
// RZ/Turbo. The real engine runs sequential turbos (a small primary that
// spools alone below ~3800rpm, then a second turbo valved in above that),
// but engine_sim has no sequential-activation model, so this is
// approximated as a parallel twin: both turbos always live, each fed by
// its own bank of three cylinders (a real, physically contiguous
// front-bank/rear-bank exhaust split, not the alternating stereo split
// atg-video-2/k20a_turbo.mr uses for a single-turbo engine), both
// compressors merging into one shared intake plenum -- the correct
// steady-state topology even though the stock sequential valving's low-RPM
// lag character isn't modeled.

private node wires {
    output wire1: ignition_wire();
    output wire2: ignition_wire();
    output wire3: ignition_wire();
    output wire4: ignition_wire();
    output wire5: ignition_wire();
    output wire6: ignition_wire();
}

private node jz_camshaft_builder {
    input lobe_profile;
    input intake_lobe_profile: lobe_profile;
    input exhaust_lobe_profile: lobe_profile;
    input lobe_separation: 116.0 * units.deg;
    input intake_lobe_center: lobe_separation;
    input exhaust_lobe_center: lobe_separation;
    input advance: 0.0 * units.deg;
    input base_radius: 0.75 * units.inch;

    output intake_cam: _intake_cam;
    output exhaust_cam: _exhaust_cam;

    camshaft_parameters params(
        advance: advance,
        base_radius: base_radius
    )

    camshaft _intake_cam(params, lobe_profile: intake_lobe_profile)
    camshaft _exhaust_cam(params, lobe_profile: exhaust_lobe_profile)

    label rot(2 * (360 / 6.0) * units.deg)
    label rot360(360 * units.deg)

    // Firing order 1-5-3-6-2-4
    _exhaust_cam
        .add_lobe((rot360 - exhaust_lobe_center) + 0 * rot)
        .add_lobe((rot360 - exhaust_lobe_center) + 4 * rot)
        .add_lobe((rot360 - exhaust_lobe_center) + 2 * rot)
        .add_lobe((rot360 - exhaust_lobe_center) + 5 * rot)
        .add_lobe((rot360 - exhaust_lobe_center) + 1 * rot)
        .add_lobe((rot360 - exhaust_lobe_center) + 3 * rot)

    _intake_cam
        .add_lobe(rot360 + intake_lobe_center + 0 * rot)
        .add_lobe(rot360 + intake_lobe_center + 4 * rot)
        .add_lobe(rot360 + intake_lobe_center + 2 * rot)
        .add_lobe(rot360 + intake_lobe_center + 5 * rot)
        .add_lobe(rot360 + intake_lobe_center + 1 * rot)
        .add_lobe(rot360 + intake_lobe_center + 3 * rot)
}

private node jz_ignition {
    input wires;
    input timing_curve;
    input rev_limit: 7200 * units.rpm;
    alias output __out:
        ignition_module(
            timing_curve: timing_curve,
            rev_limit: rev_limit,
            // Softer, longer cut than this batch's JDM RB-family sixes --
            // a stock Toyota ECU's limiter is a mild, factory-smooth
            // stutter, not a percussive bark.
            limiter_duration: 0.05
        )
            .connect_wire(wires.wire1, (0.0 / 6.0) * cycle)
            .connect_wire(wires.wire5, (1.0 / 6.0) * cycle)
            .connect_wire(wires.wire3, (2.0 / 6.0) * cycle)
            .connect_wire(wires.wire6, (3.0 / 6.0) * cycle)
            .connect_wire(wires.wire2, (4.0 / 6.0) * cycle)
            .connect_wire(wires.wire4, (5.0 / 6.0) * cycle);
}

private node jz_head {
    input intake_camshaft;
    input exhaust_camshaft;
    input chamber_volume: 49.5 * units.cc;
    input intake_runner_volume: 108.0 * units.cc;
    input intake_runner_cross_section_area: 1.45 * units.inch * 1.45 * units.inch;
    input exhaust_runner_volume: 44.0 * units.cc;
    input exhaust_runner_cross_section_area: 1.25 * units.inch * 1.25 * units.inch;

    input flow_attenuation: 1.0;
    input lift_scale: 1.0;
    input flip_display: false;
    alias output __out: head;

    function intake_flow(50 * units.thou)
    intake_flow
        .add_flow_sample(0 * lift_scale, 0 * flow_attenuation)
        .add_flow_sample(50 * lift_scale, 48 * flow_attenuation)
        .add_flow_sample(100 * lift_scale, 88 * flow_attenuation)
        .add_flow_sample(150 * lift_scale, 134 * flow_attenuation)
        .add_flow_sample(200 * lift_scale, 176 * flow_attenuation)
        .add_flow_sample(250 * lift_scale, 206 * flow_attenuation)
        .add_flow_sample(300 * lift_scale, 224 * flow_attenuation)
        .add_flow_sample(350 * lift_scale, 233 * flow_attenuation)
        .add_flow_sample(400 * lift_scale, 236 * flow_attenuation)
        .add_flow_sample(450 * lift_scale, 237 * flow_attenuation)

    function exhaust_flow(50 * units.thou)
    exhaust_flow
        .add_flow_sample(0 * lift_scale, 0 * flow_attenuation)
        .add_flow_sample(50 * lift_scale, 35 * flow_attenuation)
        .add_flow_sample(100 * lift_scale, 66 * flow_attenuation)
        .add_flow_sample(150 * lift_scale, 101 * flow_attenuation)
        .add_flow_sample(200 * lift_scale, 134 * flow_attenuation)
        .add_flow_sample(250 * lift_scale, 160 * flow_attenuation)
        .add_flow_sample(300 * lift_scale, 178 * flow_attenuation)
        .add_flow_sample(350 * lift_scale, 188 * flow_attenuation)
        .add_flow_sample(400 * lift_scale, 192 * flow_attenuation)
        .add_flow_sample(450 * lift_scale, 193 * flow_attenuation)

    generic_cylinder_head head(
        chamber_volume: chamber_volume,
        intake_runner_volume: intake_runner_volume,
        intake_runner_cross_section_area: intake_runner_cross_section_area,
        exhaust_runner_volume: exhaust_runner_volume,
        exhaust_runner_cross_section_area: exhaust_runner_cross_section_area,

        intake_port_flow: intake_flow,
        exhaust_port_flow: exhaust_flow,
        valvetrain: standard_valvetrain(
            intake_camshaft: intake_camshaft,
            exhaust_camshaft: exhaust_camshaft
        ),
        flip_display: flip_display
    )
}

public node jz_na {
    output turbo_engine: engine;
    output turbo_intake: intake;
    output turbo_exhaust0: exhaust0;
    output turbo_exhaust1: exhaust1;

    wires wires()

    engine engine(
        name: "Toyota 2JZ-GTE [Supra, Twin Turbo]",
        starter_torque: 180 * units.lb_ft,
        starter_speed: 450 * units.rpm,
        redline: 7000 * units.rpm,
        fuel: fuel(
            max_turbulence_effect: 3.1,
            max_burning_efficiency: 0.84
        ),
        throttle_gamma: 2.0,
        // Smoothest, cleanest texture in this batch of RB/S55/B58 turbo
        // sixes -- the 2JZ's famously deep, unruffled tone rather than a
        // raspy/mechanical one.
        hf_gain: 0.004,
        noise: 0.36,
        jitter: 0.15,
        simulation_frequency: 15000
    )

    // 86.0mm x 86.0mm, 2997cc, 8.5:1 compression -- real 2JZ-GTE dimensions
    // (near-square bore/stroke).
    label stroke(86.0 * units.mm)
    label bore(86.0 * units.mm)
    label rod_length(142.0 * units.mm)
    label rod_mass(560 * units.g)
    label compression_height(29.0 * units.mm)
    label crank_mass(18 * units.kg)
    label flywheel_mass(8 * units.kg)
    label flywheel_radius(6.5 * units.inch)

    label crank_moment(
        disk_moment_of_inertia(mass: crank_mass, radius: stroke / 2)
    )
    label flywheel_moment(
        disk_moment_of_inertia(mass: flywheel_mass, radius: flywheel_radius)
    )
    label other_moment(
        disk_moment_of_inertia(mass: 20 * units.kg, radius: 8.0 * units.cm)
    )

    crankshaft c0(
        throw: stroke / 2,
        flywheel_mass: flywheel_mass,
        mass: crank_mass,
        friction_torque: 7.0 * units.lb_ft,
        moment_of_inertia:
            crank_moment + flywheel_moment + other_moment,
        position_x: 0.0,
        position_y: 0.0,
        tdc: constants.pi / 2
    )

    // 1 5 3 6 2 4
    rod_journal rj0(angle: 0 * units.deg)
    rod_journal rj1(angle: 480 * units.deg)
    rod_journal rj2(angle: 240 * units.deg)
    rod_journal rj3(angle: 600 * units.deg)
    rod_journal rj4(angle: 120 * units.deg)
    rod_journal rj5(angle: 360 * units.deg)

    c0
        .add_rod_journal(rj0)
        .add_rod_journal(rj1)
        .add_rod_journal(rj2)
        .add_rod_journal(rj3)
        .add_rod_journal(rj4)
        .add_rod_journal(rj5)

    piston_parameters piston_params(
        mass: 330 * units.g,
        compression_height: compression_height,
        wrist_pin_position: 0.0,
        displacement: 0.0
    )

    connecting_rod_parameters cr_params(
        mass: rod_mass,
        moment_of_inertia: rod_moment_of_inertia(
            mass: rod_mass,
            length: rod_length
        ),
        center_of_mass: 0.0,
        length: rod_length
    )

    intake intake(
        plenum_volume: 1.4 * units.L,
        plenum_cross_section_area: 15.0 * units.cm2,
        intake_flow_rate: k_carb(650.0),
        runner_flow_rate: k_carb(225.0),
        runner_length: 7.5 * units.inch,
        idle_flow_rate: k_carb(0.0),
        // 0.9985 (0.15% open) settled just under the check tool's
        // running-floor threshold coming off the starter -- 0.998 gives
        // enough flow to hold a clean, realistic idle.
        idle_throttle_plate_position: 0.998,
        velocity_decay: 0.5,
        audio_volume: 3.0,
        impulse_response: ir_lib.mild_exhaust_0
    )

    exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(950.0),
        // Longer primary than this batch's RB-family sixes -- deeper,
        // smoother resonance instead of a sharp rasp, matching the 2JZ's
        // reputation as the calm/muted one of the bunch.
        primary_tube_length: 25.0 * units.inch,
        primary_flow_rate: k_carb(200.0),
        velocity_decay: 1.0,
        volume: 28.0 * units.L
    )

    // Cylinders 1-3 (front bank, closest to the crank pulley) feed the
    // front turbo through exhaust0; cylinders 4-6 (rear bank, closest to
    // the transmission) feed the rear turbo through exhaust1 -- a
    // contiguous physical split, matching the stock 2JZ-GTE's separate
    // front/rear exhaust manifolds so each turbo only ever sees its own
    // three cylinders' pulses.
    exhaust_system exhaust0(
        es_params,
        audio_volume: 8 * 0.8,
        // default_0 ("smooth") for the 2JZ's deep, muted tone -- distinct
        // from this batch's RB-family sixes (sharper/rawer IRs) and BMW
        // sixes (mild_exhaust variants).
        impulse_response: ir_lib.default_0
    )
    exhaust_system exhaust1(
        es_params,
        audio_volume: 8 * 1.0,
        impulse_response: ir_lib.default_0
    )

    cylinder_bank_parameters bank_params(
        bore: bore,
        deck_height: stroke / 2 + rod_length + compression_height
    )

    cylinder_bank b0(bank_params, angle: 0)
    b0
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire1,
            sound_attenuation: 0.9
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire2,
            sound_attenuation: 0.95
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire3,
            sound_attenuation: 0.9
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj3,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire4,
            sound_attenuation: 0.97
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj4,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire5,
            sound_attenuation: 0.98
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj5,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire6,
            sound_attenuation: 0.93
        )

    engine
        .add_cylinder_bank(b0)

    engine.add_crankshaft(c0)

    harmonic_cam_lobe intake_lobe(
        duration_at_50_thou: 222 * units.deg,
        gamma: 1.1,
        lift: 8.7 * units.mm,
        steps: 100
    )

    harmonic_cam_lobe exhaust_lobe(
        duration_at_50_thou: 218 * units.deg,
        gamma: 1.1,
        lift: 8.5 * units.mm,
        steps: 100
    )

    jz_camshaft_builder camshaft(
        lobe_profile: "N/A",
        intake_lobe_profile: intake_lobe,
        exhaust_lobe_profile: exhaust_lobe,
        intake_lobe_center: 116 * units.deg,
        exhaust_lobe_center: 116 * units.deg,
        base_radius: 0.75 * units.inch
    )

    b0.set_cylinder_head(
        jz_head(
            intake_camshaft: camshaft.intake_cam,
            exhaust_camshaft: camshaft.exhaust_cam
        )
    )

    function timing_curve(1000 * units.rpm)
    timing_curve
        .add_sample(0000 * units.rpm, 8 * units.deg)
        .add_sample(1000 * units.rpm, 12 * units.deg)
        .add_sample(2000 * units.rpm, 16 * units.deg)
        .add_sample(3000 * units.rpm, 20 * units.deg)
        .add_sample(4000 * units.rpm, 22 * units.deg)
        .add_sample(5000 * units.rpm, 22 * units.deg)
        .add_sample(6000 * units.rpm, 20 * units.deg)
        .add_sample(7000 * units.rpm, 18 * units.deg)

    engine.add_ignition_module(
        jz_ignition(
            wires: wires,
            timing_curve: timing_curve,
            rev_limit: 7200 * units.rpm
        )
    )
}

private node jz_twin_turbo {
    alias output __out: base.turbo_engine;

    jz_na base()

    // Twin CT12A-sized turbos (real sequential pair collapsed to parallel
    // -- see file header). Each sees only its own bank's exhaust pulses
    // and both feed the same shared plenum, per the task's twin-turbo
    // pattern.
    turbocharger turbo_front(
        intake: base.turbo_intake,
        turbine_flow_rate: k_carb(150.0),
        turbine_inertia: 0.00004,
        turbine_efficiency: 0.66,
        compressor_efficiency: 0.71,
        max_boost: 13.0 * units.psi,
        spool_speed: 155000.0 * units.rpm,
        bov_sound: bov_lib.bovaftermarket7
    )
    turbo_front.add_exhaust_system(base.turbo_exhaust0)

    turbocharger turbo_rear(
        intake: base.turbo_intake,
        turbine_flow_rate: k_carb(150.0),
        turbine_inertia: 0.00004,
        turbine_efficiency: 0.66,
        compressor_efficiency: 0.71,
        max_boost: 13.0 * units.psi,
        spool_speed: 155000.0 * units.rpm,
        bov_sound: bov_lib.bovaftermarket7
    )
    turbo_rear.add_exhaust_system(base.turbo_exhaust1)

    base.turbo_engine
        .add_turbocharger(turbo_front)
        .add_turbocharger(turbo_rear)
}

private node jz_vehicle {
    alias output __out:
        vehicle(
            mass: 3450 * units.lb,
            drag_coefficient: 0.31,
            cross_sectional_area: (71 * units.inch) * (52 * units.inch),
            diff_ratio: 3.27,
            tire_radius: 12.5 * units.inch,
            rolling_resistance: 420 * units.N
        );
}

// 6-speed Getrag V160 (JZA80 Supra RZ/Turbo manual). Ratios are the real
// stock set.
private node jz_transmission {
    alias output __out:
        transmission(
            max_clutch_torque: 420 * units.lb_ft
        )
        .add_gear(3.266)
        .add_gear(1.995)
        .add_gear(1.435)
        .add_gear(1.000)
        .add_gear(0.775)
        .add_gear(0.634);
}

public node main {
    set_engine(jz_twin_turbo())
    set_vehicle(jz_vehicle())
    set_transmission(jz_transmission())
}
