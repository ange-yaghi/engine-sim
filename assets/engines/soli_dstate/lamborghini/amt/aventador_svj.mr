import "engine_sim.mr"

units units()
constants constants()
impulse_response_library ir_lib()
label cycle(2 * 360 * units.deg)

// Lamborghini Aventador SVJ (2018-2021) -- the L539, a 6.5L naturally-
// aspirated 60-degree V12, DOHC 4-valve. Unlike this repo's Ferrari 12Cilindri
// file (assets/engines/soli_dstate/ferrari/dct/12cilindri.mr), Lamborghini's
// V12 uses a 60-degree vee that exactly matches the 720/12 = 60-degree
// even-firing spacing, so there's no bank-angle-vs-firing-spacing divergence
// to approximate here -- one v_angle constant drives everything, same as
// this repo's flat-plane V8/V10 files.
//
// Bore/stroke (95.0mm x 76.4mm, 6498cc) and compression (~11.8:1) are real
// L539 specs. Rod length, piston/rod/crank masses, port flow figures, cam
// timing, and ISR gear ratios are reasoned approximations in this repo's
// usual style -- exact factory values for those weren't available to verify
// here.
//
// FIRING ORDER: NOT the commonly-cited real-world Lamborghini V12 sequence
// (1-12-5-8-3-10-6-7-2-11-4-9) -- like the Ferrari 12Cilindri file above,
// that sequence is mechanically incompatible with this sim's "cylinder N on
// bank 0 shares a rod journal with cylinder N+6 on bank 1" convention. Two
// cylinders sharing a journal have independently-computed cam/spark timing
// but mechanically-linked pistons, so an inconsistent firing order silently
// desyncs every cylinder's valve events from where its piston actually is --
// the sim doesn't catch this at load time, it just quietly produces an
// engine that cranks but can't sustain combustion (peak chamber temperature
// capped around 1000K instead of a healthy 2300K+, zero net torque even
// under the dyno's forced rotation). Confirmed against this repo's other
// pre-existing V12 (angethegreat/atg-video-2/11_merlin_v12.mr), which fails
// the same way for the same reason, and against the Ferrari 12Cilindri file,
// where deriving the firing order from crank geometry instead of copying a
// real-world citation fixed it.
//
// The firing order actually used below is derived directly from the crank
// geometry: cylinder N on bank 0 (rod_journal rj(N-1), angle (N-1)*60deg)
// fires at that same crank angle; cylinder N+6 on bank 1 shares that
// journal but bank 1 is offset by the firing_angle (60deg, here also equal
// to v_angle) from bank 0, so it fires 60deg later than its bank-0 partner
// -- placed in the second half of the 720-degree cycle (+360deg) so it
// doesn't collide (mod 360) with a different bank-0 cylinder on another
// journal. That works out to 1-2-3-4-5-6-12-7-8-9-10-11. It's not a
// verified factory sequence (neither was the one it replaced), but unlike
// that one it's actually consistent with how this file's crank is built.

private node wires {
    output wire1: ignition_wire();
    output wire2: ignition_wire();
    output wire3: ignition_wire();
    output wire4: ignition_wire();
    output wire5: ignition_wire();
    output wire6: ignition_wire();
    output wire7: ignition_wire();
    output wire8: ignition_wire();
    output wire9: ignition_wire();
    output wire10: ignition_wire();
    output wire11: ignition_wire();
    output wire12: ignition_wire();
}

private node l539_head {
    input intake_camshaft;
    input exhaust_camshaft;
    // CR calc: swept vol/cyl @ 95x76.4mm bore/stroke =~ 541.6cc.
    // (541.6 + 50.1) / 50.1 =~ 11.8:1, matching the real L539's stock
    // ~11.8:1 compression.
    input chamber_volume: 50.1 * units.cc;
    input intake_runner_volume: 95.0 * units.cc;
    input intake_runner_cross_section_area: 1.5 * units.inch * 1.5 * units.inch;
    input exhaust_runner_volume: 37.0 * units.cc;
    input exhaust_runner_cross_section_area: 1.3 * units.inch * 1.3 * units.inch;

    input flow_attenuation: 1.0;
    input lift_scale: 1.0;
    input flip_display: false;
    alias output __out: head;

    // Big-valve 4-valve head -- slightly milder than this repo's 12Cilindri
    // file (759 hp/6.5L here vs. 807 hp/6.5L there), matching the SVJ's
    // somewhat lower redline.
    function intake_flow(50 * units.thou)
    intake_flow
        .add_flow_sample(0 * lift_scale, 0 * flow_attenuation)
        .add_flow_sample(50 * lift_scale, 47 * flow_attenuation)
        .add_flow_sample(100 * lift_scale, 87 * flow_attenuation)
        .add_flow_sample(150 * lift_scale, 134 * flow_attenuation)
        .add_flow_sample(200 * lift_scale, 177 * flow_attenuation)
        .add_flow_sample(250 * lift_scale, 207 * flow_attenuation)
        .add_flow_sample(300 * lift_scale, 225 * flow_attenuation)
        .add_flow_sample(350 * lift_scale, 236 * flow_attenuation)
        .add_flow_sample(400 * lift_scale, 240 * flow_attenuation)
        .add_flow_sample(450 * lift_scale, 242 * flow_attenuation)

    function exhaust_flow(50 * units.thou)
    exhaust_flow
        .add_flow_sample(0 * lift_scale, 0 * flow_attenuation)
        .add_flow_sample(50 * lift_scale, 36 * flow_attenuation)
        .add_flow_sample(100 * lift_scale, 68 * flow_attenuation)
        .add_flow_sample(150 * lift_scale, 106 * flow_attenuation)
        .add_flow_sample(200 * lift_scale, 140 * flow_attenuation)
        .add_flow_sample(250 * lift_scale, 166 * flow_attenuation)
        .add_flow_sample(300 * lift_scale, 180 * flow_attenuation)
        .add_flow_sample(350 * lift_scale, 189 * flow_attenuation)
        .add_flow_sample(400 * lift_scale, 193 * flow_attenuation)
        .add_flow_sample(450 * lift_scale, 194 * flow_attenuation)

    generic_cylinder_head head(
        chamber_volume: chamber_volume,
        intake_runner_volume: intake_runner_volume,
        intake_runner_cross_section_area: intake_runner_cross_section_area,
        exhaust_runner_volume: exhaust_runner_volume,
        exhaust_runner_cross_section_area: exhaust_runner_cross_section_area,

        intake_port_flow: intake_flow,
        exhaust_port_flow: exhaust_flow,
        valvetrain: standard_valvetrain(
            intake_camshaft: intake_camshaft,
            exhaust_camshaft: exhaust_camshaft
        ),
        flip_display: flip_display
    )
}

private node l539_camshaft {
    input lobe_profile;
    input intake_lobe_profile: lobe_profile;
    input exhaust_lobe_profile: lobe_profile;
    input lobe_separation: 112 * units.deg;
    input intake_lobe_center: lobe_separation;
    input exhaust_lobe_center: lobe_separation;
    input advance: 0 * units.deg;
    input base_radius: 17.0 * units.mm;

    output intake_cam_0: _intake_cam_0;
    output exhaust_cam_0: _exhaust_cam_0;

    output intake_cam_1: _intake_cam_1;
    output exhaust_cam_1: _exhaust_cam_1;

    camshaft_parameters params(
        advance: advance,
        base_radius: base_radius
    )

    // Continuously variable intake and exhaust cam timing, same on both
    // banks.
    function intake_vvt(1000 * units.rpm)
    intake_vvt
        .add_sample(0000 * units.rpm, 0 * units.deg)
        .add_sample(2500 * units.rpm, 12 * units.deg)
        .add_sample(5500 * units.rpm, 16 * units.deg)
        .add_sample(8700 * units.rpm, 8 * units.deg)

    function exhaust_vvt(1000 * units.rpm)
    exhaust_vvt
        .add_sample(0000 * units.rpm, 0 * units.deg)
        .add_sample(2500 * units.rpm, 10 * units.deg)
        .add_sample(8700 * units.rpm, 12 * units.deg)

    camshaft _intake_cam_0(params, lobe_profile: intake_lobe_profile, advance_curve: intake_vvt)
    camshaft _exhaust_cam_0(params, lobe_profile: exhaust_lobe_profile, advance_curve: exhaust_vvt)
    camshaft _intake_cam_1(params, lobe_profile: intake_lobe_profile, advance_curve: intake_vvt)
    camshaft _exhaust_cam_1(params, lobe_profile: exhaust_lobe_profile, advance_curve: exhaust_vvt)

    // 720/12 -- even-firing spacing (here also equal to the 60-degree bank
    // angle, see file header).
    label rot(60 * units.deg)
    label rot360(360 * units.deg)

    // Bank 0 = cylinders 1-6 (sequential), bank 1 = cylinders 7-12
    // (sequential), cylinder N (bank 0) sharing a rod journal with
    // cylinder N+6 (bank 1). Firing positions are derived directly from
    // crank geometry (see the FIRING ORDER note in the file header) rather
    // than the commonly-cited real-world sequence, which is mechanically
    // incompatible with this pairing. Works out to
    // 1-2-3-4-5-6-12-7-8-9-10-11.
    _exhaust_cam_0
        .add_lobe(rot360 - exhaust_lobe_center + 0 * rot)  // 1
        .add_lobe(rot360 - exhaust_lobe_center + 1 * rot)  // 2
        .add_lobe(rot360 - exhaust_lobe_center + 2 * rot)  // 3
        .add_lobe(rot360 - exhaust_lobe_center + 3 * rot)  // 4
        .add_lobe(rot360 - exhaust_lobe_center + 4 * rot)  // 5
        .add_lobe(rot360 - exhaust_lobe_center + 5 * rot)  // 6
    _intake_cam_0
        .add_lobe(rot360 + intake_lobe_center + 0 * rot)  // 1
        .add_lobe(rot360 + intake_lobe_center + 1 * rot)  // 2
        .add_lobe(rot360 + intake_lobe_center + 2 * rot)  // 3
        .add_lobe(rot360 + intake_lobe_center + 3 * rot)  // 4
        .add_lobe(rot360 + intake_lobe_center + 4 * rot)  // 5
        .add_lobe(rot360 + intake_lobe_center + 5 * rot)  // 6

    _exhaust_cam_1
        .add_lobe(rot360 - exhaust_lobe_center + 7 * rot)  // 7
        .add_lobe(rot360 - exhaust_lobe_center + 8 * rot)  // 8
        .add_lobe(rot360 - exhaust_lobe_center + 9 * rot)  // 9
        .add_lobe(rot360 - exhaust_lobe_center + 10 * rot) // 10
        .add_lobe(rot360 - exhaust_lobe_center + 11 * rot) // 11
        .add_lobe(rot360 - exhaust_lobe_center + 6 * rot)  // 12
    _intake_cam_1
        .add_lobe(rot360 + intake_lobe_center + 7 * rot)  // 7
        .add_lobe(rot360 + intake_lobe_center + 8 * rot)  // 8
        .add_lobe(rot360 + intake_lobe_center + 9 * rot)  // 9
        .add_lobe(rot360 + intake_lobe_center + 10 * rot) // 10
        .add_lobe(rot360 + intake_lobe_center + 11 * rot) // 11
        .add_lobe(rot360 + intake_lobe_center + 6 * rot)  // 12
}

public node l539_svj {
    alias output __out: engine;

    wires wires()

    engine engine(
        name: "Lamborghini L539 [Aventador SVJ, NA V12]",
        starter_torque: 170 * units.lb_ft,
        starter_speed: 300 * units.rpm,
        // Real power peak is 8500 RPM; fuel cut sits a bit above that.
        redline: 8700 * units.rpm,
        fuel: fuel(
            max_turbulence_effect: 2.9,
            max_burning_efficiency: 0.89
        ),
        throttle_gamma: 2.0,
        hf_gain: 0.0055,
        noise: 0.48,
        jitter: 0.12,
        simulation_frequency: 15000
    )

    // 95.0mm x 76.4mm, 6498cc -- real L539 dimensions. Rod length/
    // compression height are plausible estimates for a short-stroke,
    // high-revving V12 of this size, not exact factory figures.
    label stroke(76.4 * units.mm)
    label bore(95.0 * units.mm)
    label rod_length(140.0 * units.mm)
    label rod_mass(380 * units.g)
    label compression_height(25.0 * units.mm)
    label crank_mass(26 * units.kg)
    label flywheel_mass(9 * units.kg)
    label flywheel_radius(5.2 * units.inch)

    label crank_moment(
        1.5 * disk_moment_of_inertia(mass: crank_mass, radius: stroke / 2)
    )
    label flywheel_moment(
        disk_moment_of_inertia(mass: flywheel_mass, radius: flywheel_radius)
    )
    label other_moment(
        disk_moment_of_inertia(mass: 2 * units.kg, radius: 3.0 * units.cm)
    )

    // Real included bank angle -- exactly matches the 60-degree even-firing
    // spacing (see file header), unlike the Ferrari 12Cilindri file.
    label v_angle(60 * units.deg)

    crankshaft c0(
        throw: stroke / 2,
        flywheel_mass: flywheel_mass,
        mass: crank_mass,
        friction_torque: 14.0 * units.lb_ft,
        moment_of_inertia:
            crank_moment + flywheel_moment + other_moment,
        position_x: 0.0,
        position_y: 0.0,
        tdc: 90 * units.deg + (v_angle / 2.0)
    )

    // Six unique throws, 60 degrees apart, each shared between bank 0's
    // Nth cylinder and bank 1's Nth cylinder -- same fork-rod convention
    // as this repo's other V-engines. See the FIRING ORDER note in the
    // file header for how cam/wire timing is kept consistent with this
    // pairing.
    rod_journal rj0(angle: 0 * units.deg)
    rod_journal rj1(angle: 60 * units.deg)
    rod_journal rj2(angle: 120 * units.deg)
    rod_journal rj3(angle: 180 * units.deg)
    rod_journal rj4(angle: 240 * units.deg)
    rod_journal rj5(angle: 300 * units.deg)
    c0
        .add_rod_journal(rj0)
        .add_rod_journal(rj1)
        .add_rod_journal(rj2)
        .add_rod_journal(rj3)
        .add_rod_journal(rj4)
        .add_rod_journal(rj5)

    piston_parameters piston_params(
        mass: 310 * units.g,
        compression_height: compression_height,
        wrist_pin_position: 0.0,
        displacement: 0.0
    )

    connecting_rod_parameters cr_params(
        mass: rod_mass,
        moment_of_inertia: rod_moment_of_inertia(
            mass: rod_mass,
            length: rod_length
        ),
        center_of_mass: 0.0,
        length: rod_length
    )

    intake intake(
        plenum_volume: 3.2 * units.L,
        plenum_cross_section_area: 40.0 * units.cm2,
        intake_flow_rate: k_carb(1400.0),
        runner_flow_rate: k_carb(420.0),
        runner_length: 6.0 * units.inch,
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 0.997,
        velocity_decay: 0.45,
        audio_volume: 3.0,
        impulse_response: ir_lib.mild_exhaust_0
    )

    exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(1250.0),
        primary_tube_length: 22.0 * units.inch,
        primary_flow_rate: k_carb(270.0),
        velocity_decay: 0.6,
        volume: 26.0 * units.L
    )

    exhaust_system exhaust0(
        es_params,
        audio_volume: 8 * 0.9,
        impulse_response: ir_lib.mild_exhaust_0
    )
    exhaust_system exhaust1(
        es_params,
        audio_volume: 8 * 1.0,
        impulse_response: ir_lib.mild_exhaust_0
    )

    cylinder_bank_parameters bank_params(
        bore: bore,
        deck_height: stroke / 2 + rod_length + compression_height
    )

    cylinder_bank b0(bank_params, angle: v_angle / 2.0)
    cylinder_bank b1(bank_params, angle: -v_angle / 2.0)
    b0
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.1)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire1,
            sound_attenuation: 0.9,
            primary_length: 2 * units.cm
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.1)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire2,
            sound_attenuation: 0.85,
            primary_length: 1 * units.cm
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.1)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire3,
            sound_attenuation: 1.05,
            primary_length: 3 * units.cm
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.1)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj3,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire4,
            sound_attenuation: 1.0,
            primary_length: 5 * units.cm
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.1)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj4,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire5,
            sound_attenuation: 0.95,
            primary_length: 4 * units.cm
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.1)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj5,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire6,
            sound_attenuation: 0.9,
            primary_length: 0 * units.cm
        )
        .set_cylinder_head(
            l539_head(
                intake_camshaft: camshaft.intake_cam_0,
                exhaust_camshaft: camshaft.exhaust_cam_0,
                flip_display: true
            )
        )
    b1
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.1)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire7,
            sound_attenuation: 1.0,
            primary_length: 1 * units.cm
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.1)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire8,
            sound_attenuation: 0.85,
            primary_length: 5 * units.cm
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.1)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire9,
            sound_attenuation: 0.95,
            primary_length: 7 * units.cm
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.1)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj3,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire10,
            sound_attenuation: 0.9,
            primary_length: 3 * units.cm
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.1)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj4,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire11,
            sound_attenuation: 1.0,
            primary_length: 6 * units.cm
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.1)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj5,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire12,
            sound_attenuation: 0.8,
            primary_length: 0 * units.cm
        )
        .set_cylinder_head(
            l539_head(
                intake_camshaft: camshaft.intake_cam_1,
                exhaust_camshaft: camshaft.exhaust_cam_1
            )
        )

    engine
        .add_cylinder_bank(b0)
        .add_cylinder_bank(b1)

    engine.add_crankshaft(c0)

    // Aggressive DOHC lobe for an 8500 RPM power peak -- slightly milder
    // than the 12Cilindri file's, matching the SVJ's lower redline.
    harmonic_cam_lobe intake_lobe(
        duration_at_50_thou: 236 * units.deg,
        gamma: 1.0,
        lift: 12.5 * units.mm,
        steps: 150
    )

    harmonic_cam_lobe exhaust_lobe(
        duration_at_50_thou: 228 * units.deg,
        gamma: 1.0,
        lift: 11.5 * units.mm,
        steps: 150
    )

    l539_camshaft camshaft(
        lobe_profile: "N/A",
        intake_lobe_profile: intake_lobe,
        exhaust_lobe_profile: exhaust_lobe,
        intake_lobe_center: 112 * units.deg,
        exhaust_lobe_center: 112 * units.deg,
        base_radius: 17.0 * units.mm
    )

    function timing_curve(1000 * units.rpm)
    timing_curve
        .add_sample(0000 * units.rpm, 14 * units.deg)
        .add_sample(1000 * units.rpm, 16 * units.deg)
        .add_sample(2000 * units.rpm, 20 * units.deg)
        .add_sample(3000 * units.rpm, 22 * units.deg)
        .add_sample(4000 * units.rpm, 24 * units.deg)
        .add_sample(5000 * units.rpm, 24 * units.deg)
        .add_sample(6000 * units.rpm, 23 * units.deg)
        .add_sample(7000 * units.rpm, 21 * units.deg)
        .add_sample(8000 * units.rpm, 19 * units.deg)

    ignition_module ignition_module(
        timing_curve: timing_curve,
        rev_limit: 8800 * units.rpm,
        limiter_duration: 0.018
    )
    // Firing order 1-2-3-4-5-6-12-7-8-9-10-11 -- see the FIRING ORDER note
    // in the file header for why it's this and not the commonly-cited
    // real-world sequence.
    ignition_module
        .connect_wire(wires.wire1,  0 * 60 * units.deg)
        .connect_wire(wires.wire2,  1 * 60 * units.deg)
        .connect_wire(wires.wire3,  2 * 60 * units.deg)
        .connect_wire(wires.wire4,  3 * 60 * units.deg)
        .connect_wire(wires.wire5,  4 * 60 * units.deg)
        .connect_wire(wires.wire6,  5 * 60 * units.deg)
        .connect_wire(wires.wire12, 6 * 60 * units.deg)
        .connect_wire(wires.wire7,  7 * 60 * units.deg)
        .connect_wire(wires.wire8,  8 * 60 * units.deg)
        .connect_wire(wires.wire9,  9 * 60 * units.deg)
        .connect_wire(wires.wire10, 10 * 60 * units.deg)
        .connect_wire(wires.wire11, 11 * 60 * units.deg)

    engine.add_ignition_module(ignition_module)
}

// AWD, mid-engine Aventador -- heavy for a supercar (carbon monocoque
// notwithstanding) thanks to the AWD hardware; AWD torque split itself
// isn't a separate input to this sim's vehicle node.
private node aventador_svj_vehicle {
    alias output __out:
        vehicle(
            mass: 1660 * units.kg,
            drag_coefficient: 0.36,
            cross_sectional_area: (72 * units.inch) * (46 * units.inch),
            diff_ratio: 3.5,
            tire_radius: 13.0 * units.inch,
            rolling_resistance: 270 * units.N
        );
}

// Lamborghini's ISR (Independent Shifting Rod) 7-speed -- a single-clutch
// automated manual, not a dual-clutch, famous for shifting very fast but
// with a hard, uninterrupted torque cut through each shift (there's no
// second clutch already spinning to hand off to). Modeled the same way
// this repo's other single-clutch automated-manual boxes are (see
// ferrari/amt/f129.mr's F355 F1 and bmw/amt/S85B50_smg.mr's SMG): quick
// shift_time but a deep shift_torque_cut. Gear ratios are a plausible
// approximation of the real ISR's spread, not verified factory figures.
private node aventador_svj_isr {
    alias output __out:
        transmission(
            max_clutch_torque: 550 * units.lb_ft,
            type: "automated_manual",
            has_sport_mode: true,
            allow_manual_shift: true,
            shift_up_rpm_closed_throttle: 4200 * units.rpm,
            shift_up_rpm_wot: 8600 * units.rpm,
            shift_down_rpm_closed_throttle: 2200 * units.rpm,
            shift_down_rpm_wot: 5500 * units.rpm,
