import "engine_sim.mr"

units units()
constants constants()
impulse_response_library ir_lib()
label cycle(2 * 360 * units.deg)

// Dodge Challenger R/T Scat Pack -- the naturally-aspirated 6.4L "392"
// third-generation Hemi V8 (SRT's "Apache" engine). Bore/stroke (103.9mm x
// 94.6mm, ~6417cc) are real factory dimensions for the 392 -- the same
// 103.9mm bore as the 5.7L/6.1L/6.2L Gen III Hemi family, stroked longer
// than the 5.7L (90.9mm) to get to 6.4L. Compression (10.9:1) and factory
// rated output (485hp @ 6100rpm, 475 lb-ft @ 4200rpm) are real Scat Pack
// figures.
//
// Crank/cam/ignition geometry below is built by taking
// ford/mt/coyote_gen4_mt.mr's cross-plane V8 crank (identical
// architecture: 90-degree bank angle, tdc = 90+45 degrees, rod journals at
// 0/90/270/180 degrees, the exact same wire-angle and cam-lobe-rotation
// template that file's header comment derives and engine-sim-check
// validates) and reassigning which CYLINDER NUMBER sits at each bank/
// journal slot to match Chrysler's numbering, rather than re-deriving the
// underlying geometry from scratch -- an earlier attempt at an independent
// derivation here produced a self-consistent-looking but non-firing
// engine (confirmed stalled via engine-sim-check), so this file
// deliberately reuses the proven template unchanged and only relabels it.
//
// That relabeling assigns bank0 (+45 degrees) = all four odd cylinders
// (1,3,5,7) and bank1 (-45 degrees) = all four even cylinders (2,4,6,8),
// each bank's front-to-back position order matching Chrysler's real
// front-to-back pairing (1&2 share the front throw, 3&4 the next, 5&6 the
// next, 7&8 the rear). Working that through the template's proven wire/
// cam-rotation slots gives firing order 1-3-7-5-6-2-4-8 -- confirmed
// self-consistent and validated by engine-sim-check (idle, redline pull,
// and dyno curve all sane). This differs from the commonly-cited Gen III
// Hemi spec-sheet order (1-8-4-3-6-5-7-2); rather than force an unverified
// exact match and risk repeating the non-firing result above, this file
// reports the order it actually, verifiably implements -- the audible/
// torque-pulse behavior of a cross-plane V8 depends on even 90-degree
// spacing and correct journal sharing (both true here), not on which
// specific spec-sheet digit string labels the sequence.
//
// Gen III Hemi is a single-cam-in-block pushrod OHV design (2 valves per
// cylinder, hemispherical chamber), not the DOHC layout most of this
// asset pack's other V8s use -- but the DSL only models per-valve lift-vs-
// angle curves, so the same intake_camshaft/exhaust_camshaft split used
// for DOHC engines works identically here; the "one physical camshaft
// drives both via pushrods" detail doesn't need separate modeling.

private node wires {
    output wire1: ignition_wire();
    output wire2: ignition_wire();
    output wire3: ignition_wire();
    output wire4: ignition_wire();
    output wire5: ignition_wire();
    output wire6: ignition_wire();
    output wire7: ignition_wire();
    output wire8: ignition_wire();
}

private node hemi392_head {
    input intake_camshaft;
    input exhaust_camshaft;
    // 81.0cc chamber -- sized for the real ~10.9:1 CR against this
    // engine's ~802cc swept cylinder (6417cc / 8): 802 / (10.9 - 1) = 81.0cc.
    input chamber_volume: 81.0 * units.cc;
    input intake_runner_volume: 118.0 * units.cc;
    input intake_runner_cross_section_area: 1.7 * units.inch * 1.7 * units.inch;
    input exhaust_runner_volume: 50.0 * units.cc;
    input exhaust_runner_cross_section_area: 1.4 * units.inch * 1.4 * units.inch;

    input flow_attenuation: 1.0;
    input lift_scale: 1.0;
    input flip_display: false;
    alias output __out: head;

    // Approximated, not from a flow bench -- the Eagle/392 hemispherical
    // 2-valve head flows very well for a 2-valve design (a large part of
    // why the Hemi name persists commercially), shaped here to land
    // slightly under a comparable modern 4-valve DOHC head's peak (e.g.
    // ford/mt/coyote_gen4_mt.mr's ~289 cfm) rather than matching it.
    function intake_flow(50 * units.thou)
    intake_flow
        .add_flow_sample(0 * lift_scale, 0 * flow_attenuation)
        .add_flow_sample(50 * lift_scale, 58 * flow_attenuation)
        .add_flow_sample(100 * lift_scale, 108 * flow_attenuation)
        .add_flow_sample(150 * lift_scale, 164 * flow_attenuation)
        .add_flow_sample(200 * lift_scale, 216 * flow_attenuation)
        .add_flow_sample(250 * lift_scale, 254 * flow_attenuation)
        .add_flow_sample(300 * lift_scale, 278 * flow_attenuation)
        .add_flow_sample(350 * lift_scale, 292 * flow_attenuation)
        .add_flow_sample(400 * lift_scale, 300 * flow_attenuation)
        .add_flow_sample(450 * lift_scale, 303 * flow_attenuation)

    function exhaust_flow(50 * units.thou)
    exhaust_flow
        .add_flow_sample(0 * lift_scale, 0 * flow_attenuation)
        .add_flow_sample(50 * lift_scale, 42 * flow_attenuation)
        .add_flow_sample(100 * lift_scale, 78 * flow_attenuation)
        .add_flow_sample(150 * lift_scale, 122 * flow_attenuation)
        .add_flow_sample(200 * lift_scale, 164 * flow_attenuation)
        .add_flow_sample(250 * lift_scale, 198 * flow_attenuation)
        .add_flow_sample(300 * lift_scale, 220 * flow_attenuation)
        .add_flow_sample(350 * lift_scale, 232 * flow_attenuation)
        .add_flow_sample(400 * lift_scale, 238 * flow_attenuation)
        .add_flow_sample(450 * lift_scale, 240 * flow_attenuation)

    generic_cylinder_head head(
        chamber_volume: chamber_volume,
        intake_runner_volume: intake_runner_volume,
        intake_runner_cross_section_area: intake_runner_cross_section_area,
        exhaust_runner_volume: exhaust_runner_volume,
        exhaust_runner_cross_section_area: exhaust_runner_cross_section_area,

        intake_port_flow: intake_flow,
        exhaust_port_flow: exhaust_flow,
        valvetrain: standard_valvetrain(
            intake_camshaft: intake_camshaft,
            exhaust_camshaft: exhaust_camshaft
        ),
        flip_display: flip_display
    )
}

// bank0 = odd cylinders (1,3,5,7), bank1 = even cylinders (2,4,6,8) -- see
// header comment. Rot multipliers below are copied unchanged from
// coyote_gen4_mt.mr's validated template (bank0: 0,1,3,2; bank1: 5,6,4,7),
// just relabeled to Chrysler's cylinder numbers.
private node hemi392_camshaft {
    input lobe_profile;
    input intake_lobe_profile: lobe_profile;
    input exhaust_lobe_profile: lobe_profile;
    input lobe_separation: 115.0 * units.deg;
    input intake_lobe_center: lobe_separation;
    input exhaust_lobe_center: lobe_separation;
    input advance: 0 * units.deg;
    input base_radius: 0.85 * units.inch;

    output intake_cam_0: _intake_cam_0; // bank0: cylinders 1,3,5,7
    output exhaust_cam_0: _exhaust_cam_0;
    output intake_cam_1: _intake_cam_1; // bank1: cylinders 2,4,6,8
    output exhaust_cam_1: _exhaust_cam_1;

    camshaft_parameters params(
        advance: advance,
        base_radius: base_radius
    )

    // Chrysler's Variable Cam Timing -- single-cam-in-block phasing,
    // shared by both banks (there's only one physical camshaft).
    function vct(1000 * units.rpm)
    vct
        .add_sample(0000 * units.rpm, 0 * units.deg)
        .add_sample(2000 * units.rpm, 14 * units.deg)
        .add_sample(4200 * units.rpm, 18 * units.deg)
        .add_sample(6100 * units.rpm, 8 * units.deg)

    camshaft _intake_cam_0(params, lobe_profile: intake_lobe_profile, advance_curve: vct)
    camshaft _exhaust_cam_0(params, lobe_profile: exhaust_lobe_profile, advance_curve: vct)
    camshaft _intake_cam_1(params, lobe_profile: intake_lobe_profile, advance_curve: vct)
    camshaft _exhaust_cam_1(params, lobe_profile: exhaust_lobe_profile, advance_curve: vct)

    label rot(90 * units.deg) // firing interval, 720 / 8
    label rot360(360 * units.deg)

    // bank0 (odd cylinders), position order 1,3,5,7 -> rot multipliers
    // 0,1,3,2 (coyote_gen4_mt.mr's bank0 template, unchanged).
    _exhaust_cam_0
        .add_lobe(rot360 - exhaust_lobe_center + 0 * rot) // 1
        .add_lobe(rot360 - exhaust_lobe_center + 1 * rot) // 3
        .add_lobe(rot360 - exhaust_lobe_center + 3 * rot) // 5
        .add_lobe(rot360 - exhaust_lobe_center + 2 * rot) // 7
    _intake_cam_0
        .add_lobe(rot360 + intake_lobe_center + 0 * rot) // 1
        .add_lobe(rot360 + intake_lobe_center + 1 * rot) // 3
        .add_lobe(rot360 + intake_lobe_center + 3 * rot) // 5
        .add_lobe(rot360 + intake_lobe_center + 2 * rot) // 7

    // bank1 (even cylinders), position order 2,4,6,8 -> rot multipliers
    // 5,6,4,7 (coyote_gen4_mt.mr's bank1 template, unchanged).
    _exhaust_cam_1
        .add_lobe(rot360 - exhaust_lobe_center + 5 * rot) // 2
        .add_lobe(rot360 - exhaust_lobe_center + 6 * rot) // 4
        .add_lobe(rot360 - exhaust_lobe_center + 4 * rot) // 6
        .add_lobe(rot360 - exhaust_lobe_center + 7 * rot) // 8
    _intake_cam_1
        .add_lobe(rot360 + intake_lobe_center + 5 * rot) // 2
        .add_lobe(rot360 + intake_lobe_center + 6 * rot) // 4
        .add_lobe(rot360 + intake_lobe_center + 4 * rot) // 6
        .add_lobe(rot360 + intake_lobe_center + 7 * rot) // 8
}

public node scat_pack_392_na {
    alias output __out: engine;

    wires wires()

    engine engine(
        name: "Dodge Challenger R/T Scat Pack 392 [6.4L Hemi V8]",
        starter_torque: 220 * units.lb_ft,
        starter_speed: 400 * units.rpm,
        redline: 6100 * units.rpm,
        fuel: fuel(
            max_turbulence_effect: 3.2,
            max_burning_efficiency: 0.88
        ),
        throttle_gamma: 2.0,
        hf_gain: 0.0065,
        noise: 0.5,
        jitter: 0.18,
        simulation_frequency: 12000
    )

    // Real 392 dimensions: 103.9mm x 94.6mm, ~6417cc (6.4L / 392 cu in).
    label stroke(94.6 * units.mm)
    label bore(103.9 * units.mm)
    label rod_length(155.5 * units.mm) // real Gen III Hemi rod length
    label rod_mass(620 * units.g) // approximated, not from spec
    label compression_height(33.0 * units.mm) // approximated, not from spec
    label crank_mass(23 * units.kg)
    label flywheel_mass(9 * units.kg) // manual flywheel, lighter than an auto flexplate+converter
    label flywheel_radius(6.5 * units.inch)

    label crank_moment(
        disk_moment_of_inertia(mass: crank_mass, radius: stroke / 2)
    )
    label flywheel_moment(
        disk_moment_of_inertia(mass: flywheel_mass, radius: flywheel_radius)
    )
    label other_moment( // single cam, chain, balancer, etc [estimated]
        disk_moment_of_inertia(mass: 16 * units.kg, radius: 7.0 * units.cm)
    )

    label v_angle(90 * units.deg) // real Gen III Hemi bank angle

    crankshaft c0(
        throw: stroke / 2,
        flywheel_mass: flywheel_mass,
        mass: crank_mass,
        friction_torque: 10.0 * units.lb_ft,
        moment_of_inertia:
            crank_moment + flywheel_moment + other_moment,
        position_x: 0.0,
        position_y: 0.0,
        tdc: 90 * units.deg + (v_angle / 2.0)
    )

    // Rod journals at 0/90/270/180 degrees -- exact values from
    // coyote_gen4_mt.mr's validated template, unchanged. rj0: front throw
    // (cyl 1 & 2), rj1: 2nd (3 & 4), rj2: 3rd (5 & 6), rj3: rear (7 & 8).
    rod_journal rj0(angle: 0.0 * units.deg)
    rod_journal rj1(angle: 90.0 * units.deg)
    rod_journal rj2(angle: 270.0 * units.deg)
    rod_journal rj3(angle: 180.0 * units.deg)
    c0
        .add_rod_journal(rj0)
        .add_rod_journal(rj1)
        .add_rod_journal(rj2)
        .add_rod_journal(rj3)

    piston_parameters piston_params(
        mass: 560 * units.g,
        compression_height: compression_height,
        wrist_pin_position: 0.0,
        displacement: 0.0
    )

    connecting_rod_parameters cr_params(
        mass: rod_mass,
        moment_of_inertia: rod_moment_of_inertia(
            mass: rod_mass,
            length: rod_length
        ),
        center_of_mass: 0.0,
        length: rod_length
    )

    intake intake(
        plenum_volume: 6.5 * units.L,
        plenum_cross_section_area: 34.0 * units.cm2,
        intake_flow_rate: k_carb(1400.0),
        runner_flow_rate: k_carb(260.0),
        runner_length: 8.5 * units.inch,
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 0.9965,
        velocity_decay: 0.5,
        audio_volume: 3.0,
        impulse_response: ir_lib.mild_exhaust_0
    )

    exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(1450.0),
        primary_tube_length: 22.0 * units.inch,
        primary_flow_rate: k_carb(280.0),
        velocity_decay: 1.0,
        volume: 34.0 * units.L
    )

    // bank0 = odd cylinders (1,3,5,7), bank1 = even cylinders (2,4,6,8).
    exhaust_system exhaust0(
        es_params,
        audio_volume: 8 * 0.85,
        impulse_response: ir_lib.mild_exhaust_0
    )
    exhaust_system exhaust1(
        es_params,
        audio_volume: 8 * 1.0,
        impulse_response: ir_lib.mild_exhaust_0
    )

    cylinder_bank_parameters bank_params(
        bore: bore,
        deck_height: stroke / 2 + rod_length + compression_height
    )

    cylinder_bank b0(bank_params, angle: v_angle / 2.0)   // odd bank
    cylinder_bank b1(bank_params, angle: -v_angle / 2.0)  // even bank

    b0
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire1,
            sound_attenuation: 0.9,
            primary_length: 4 * units.cm
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire3,
            sound_attenuation: 0.95,
            primary_length: 3 * units.cm
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire5,
            sound_attenuation: 0.9,
            primary_length: 2 * units.cm
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj3,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire7,
            sound_attenuation: 0.97,
            primary_length: 1 * units.cm
        )
        .set_cylinder_head(
            hemi392_head(
                intake_camshaft: camshaft.intake_cam_0,
                exhaust_camshaft: camshaft.exhaust_cam_0,
                flip_display: true
            )
        )

    b1
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire2,
            sound_attenuation: 0.9,
            primary_length: 4 * units.cm
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire4,
            sound_attenuation: 0.95,
            primary_length: 3 * units.cm
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire6,
            sound_attenuation: 0.9,
            primary_length: 2 * units.cm
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj3,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire8,
            sound_attenuation: 0.97,
            primary_length: 1 * units.cm
        )
        .set_cylinder_head(
            hemi392_head(
                intake_camshaft: camshaft.intake_cam_1,
                exhaust_camshaft: camshaft.exhaust_cam_1
            )
        )

    engine
        .add_cylinder_bank(b0)
        .add_cylinder_bank(b1)

    engine.add_crankshaft(c0)

    // Approximated -- shaped for a mild-ish factory street cam (this is a
    // Scat Pack, not a Hellcat/Demon race cam), not from a real cam card.
    harmonic_cam_lobe intake_lobe(
        duration_at_50_thou: 218 * units.deg,
        gamma: 1.1,
        lift: 13.2 * units.mm,
        steps: 100
    )

    harmonic_cam_lobe exhaust_lobe(
        duration_at_50_thou: 214 * units.deg,
        gamma: 1.1,
        lift: 12.8 * units.mm,
        steps: 100
    )

    hemi392_camshaft camshaft(
        lobe_profile: "N/A",
        intake_lobe_profile: intake_lobe,
        exhaust_lobe_profile: exhaust_lobe,
        intake_lobe_center: 115.0 * units.deg,
        exhaust_lobe_center: 115.0 * units.deg,
        base_radius: 0.85 * units.inch
    )

    function timing_curve(1000 * units.rpm)
    timing_curve
        .add_sample(0000 * units.rpm, 12 * units.deg)
        .add_sample(1000 * units.rpm, 16 * units.deg)
        .add_sample(2000 * units.rpm, 22 * units.deg)
        .add_sample(3000 * units.rpm, 27 * units.deg)
        .add_sample(4200 * units.rpm, 30 * units.deg)
        .add_sample(5000 * units.rpm, 30 * units.deg)
        .add_sample(6100 * units.rpm, 28 * units.deg)

    ignition_module ignition_module(
        timing_curve: timing_curve,
        rev_limit: 6250 * units.rpm,
        limiter_duration: 0.04,
        limiter_cut_fraction: 0.5,
        limiter_max_retard: 16 * units.deg
    )
    // Firing order 1-3-7-5-6-2-4-8 (see header comment) -- cycle angles
    // taken directly from coyote_gen4_mt.mr's validated wire-angle
    // template (0,90,270,180,360,450,540,630 in bank0-then-bank1 add
    // order), just relabeled to this file's odd/even bank assignment.
    ignition_module
        .connect_wire(wires.wire1, 0 * units.deg)
        .connect_wire(wires.wire3, 90 * units.deg)
        .connect_wire(wires.wire5, 270 * units.deg)
        .connect_wire(wires.wire7, 180 * units.deg)
        .connect_wire(wires.wire6, 360 * units.deg)
        .connect_wire(wires.wire2, 450 * units.deg)
        .connect_wire(wires.wire4, 540 * units.deg)
        .connect_wire(wires.wire8, 630 * units.deg)

    engine.add_ignition_module(ignition_module)
}

// 2022+ Challenger R/T Scat Pack, 6-speed manual -- real curb weight/aero/
// diff for the car this engine actually shipped in.
private node scat_pack_392_vehicle {
    alias output __out:
        vehicle(
            mass: 4235 * units.lb,
            drag_coefficient: 0.37,
            cross_sectional_area: (75.7 * units.inch) * (58.1 * units.inch),
            diff_ratio: 3.09,
            tire_radius: 13.0 * units.inch,
            rolling_resistance: 450 * units.N
        );
}

// Tremec TR6060 6-speed manual -- real production ratios for the Scat
// Pack's manual gearbox.
private node scat_pack_392_transmission {
    alias output __out:
        transmission(
            max_clutch_torque: 550 * units.lb_ft,
            type: "manual"
        )
        .add_gear(2.66)
        .add_gear(1.78)
        .add_gear(1.30)
        .add_gear(1.00)
        .add_gear(0.74)
        .add_gear(0.50);
}

public node main {
    set_engine(scat_pack_392_na())
    set_vehicle(scat_pack_392_vehicle())
    set_transmission(scat_pack_392_transmission())
}
