import "engine_sim.mr"

units units()
constants constants()
impulse_response_library ir_lib()
bov_sound_library bov_lib()
label cycle(2 * 360 * units.deg)

// Ford 2.3L EcoBoost -- the turbo inline-4 shared by the S550 Mustang
// EcoBoost and the Focus RS (uprated here to RS spec: bigger twin-scroll
// turbo, 350hp/350lb-ft vs. the Mustang's stock tune). Iron block, direct
// injection, same basic bottom end architecture in both applications.

private node wires {
    output wire1: ignition_wire();
    output wire2: ignition_wire();
    output wire3: ignition_wire();
    output wire4: ignition_wire();
}

private node eb23_camshaft_builder {
    input lobe_profile;
    input intake_lobe_profile: lobe_profile;
    input exhaust_lobe_profile: lobe_profile;
    input lobe_separation: 112 * units.deg;
    input intake_lobe_center: lobe_separation;
    input exhaust_lobe_center: lobe_separation;
    input advance: 0 * units.deg;
    input base_radius: 17.0 * units.mm;

    output intake_cam: _intake_cam;
    output exhaust_cam: _exhaust_cam;

    camshaft_parameters params(
        advance: advance,
        base_radius: base_radius
    )

    // Ti-VCT -- twin independent cam phasing (both intake and exhaust,
    // each on their own electric phaser). Retarded at idle for a stable
    // burn, advances through the midrange for torque, pulled back some
    // near redline to favor cylinder filling under boost.
    function intake_vvt(1000 * units.rpm)
    intake_vvt
        .add_sample(0000 * units.rpm, 0 * units.deg)
        .add_sample(2000 * units.rpm, 14 * units.deg)
        .add_sample(4000 * units.rpm, 18 * units.deg)
        .add_sample(6000 * units.rpm, 10 * units.deg)
        .add_sample(6800 * units.rpm, 6 * units.deg)

    function exhaust_vvt(1000 * units.rpm)
    exhaust_vvt
        .add_sample(0000 * units.rpm, 0 * units.deg)
        .add_sample(2000 * units.rpm, 8 * units.deg)
        .add_sample(4000 * units.rpm, 12 * units.deg)
        .add_sample(6800 * units.rpm, 12 * units.deg)

    camshaft _intake_cam(params, lobe_profile: intake_lobe_profile, advance_curve: intake_vvt)
    camshaft _exhaust_cam(params, lobe_profile: exhaust_lobe_profile, advance_curve: exhaust_vvt)

    label rot360(360 * units.deg)

    // Firing order 1-3-4-2
    _exhaust_cam
        .add_lobe(rot360 + exhaust_lobe_center - (0.0 / 4) * cycle)
        .add_lobe(rot360 + exhaust_lobe_center - (3.0 / 4) * cycle)
        .add_lobe(rot360 + exhaust_lobe_center - (1.0 / 4) * cycle)
        .add_lobe(rot360 + exhaust_lobe_center - (2.0 / 4) * cycle)
    _intake_cam
        .add_lobe(rot360 - intake_lobe_center - (0.0 / 4) * cycle)
        .add_lobe(rot360 - intake_lobe_center - (3.0 / 4) * cycle)
        .add_lobe(rot360 - intake_lobe_center - (1.0 / 4) * cycle)
        .add_lobe(rot360 - intake_lobe_center - (2.0 / 4) * cycle)
}

private node eb23_head {
    input intake_camshaft;
    input exhaust_camshaft;
    input chamber_volume: 53.0 * units.cc;
    input intake_runner_volume: 106.0 * units.cc;
    input intake_runner_cross_section_area: 1.5 * units.inch * 1.5 * units.inch;
    input exhaust_runner_volume: 48.0 * units.cc;
    input exhaust_runner_cross_section_area: 1.3 * units.inch * 1.3 * units.inch;

    input flow_attenuation: 1.0;
    input lift_scale: 1.0;
    input flip_display: false;
    alias output __out: head;

    function intake_flow(50 * units.thou)
    intake_flow
        .add_flow_sample(0 * lift_scale, 0 * flow_attenuation)
        .add_flow_sample(50 * lift_scale, 98 * flow_attenuation)
        .add_flow_sample(100 * lift_scale, 184 * flow_attenuation)
        .add_flow_sample(150 * lift_scale, 277 * flow_attenuation)
        .add_flow_sample(200 * lift_scale, 364 * flow_attenuation)
        .add_flow_sample(250 * lift_scale, 428 * flow_attenuation)
        .add_flow_sample(300 * lift_scale, 464 * flow_attenuation)
        .add_flow_sample(350 * lift_scale, 483 * flow_attenuation)
        .add_flow_sample(400 * lift_scale, 491 * flow_attenuation)
        .add_flow_sample(450 * lift_scale, 495 * flow_attenuation)

    function exhaust_flow(50 * units.thou)
    exhaust_flow
        .add_flow_sample(0 * lift_scale, 0 * flow_attenuation)
        .add_flow_sample(50 * lift_scale, 80 * flow_attenuation)
        .add_flow_sample(100 * lift_scale, 148 * flow_attenuation)
        .add_flow_sample(150 * lift_scale, 226 * flow_attenuation)
        .add_flow_sample(200 * lift_scale, 298 * flow_attenuation)
        .add_flow_sample(250 * lift_scale, 350 * flow_attenuation)
        .add_flow_sample(300 * lift_scale, 386 * flow_attenuation)
        .add_flow_sample(350 * lift_scale, 405 * flow_attenuation)
        .add_flow_sample(400 * lift_scale, 415 * flow_attenuation)
        .add_flow_sample(450 * lift_scale, 417 * flow_attenuation)

    generic_cylinder_head head(
        chamber_volume: chamber_volume,
        intake_runner_volume: intake_runner_volume,
        intake_runner_cross_section_area: intake_runner_cross_section_area,
        exhaust_runner_volume: exhaust_runner_volume,
        exhaust_runner_cross_section_area: exhaust_runner_cross_section_area,

        intake_port_flow: intake_flow,
        exhaust_port_flow: exhaust_flow,
        valvetrain: standard_valvetrain(
            intake_camshaft: intake_camshaft,
            exhaust_camshaft: exhaust_camshaft
        ),
        flip_display: flip_display
    )
}

public node eb23_na {
    output turbo_engine: engine;
    output turbo_intake: intake;
    output turbo_exhaust0: exhaust0;
    output turbo_exhaust1: exhaust1;

    wires wires()

    engine engine(
        name: "Ford 2.3L EcoBoost [Focus RS / Mustang, Turbo I4]",
        starter_torque: 60 * units.lb_ft,
        starter_speed: -400 * units.rpm,
        redline: 6800 * units.rpm,
        fuel: fuel(
            max_turbulence_effect: 3.0,
            max_burning_efficiency: 0.82
        ),
        throttle_gamma: 2.0,
        hf_gain: 0.0042,
        noise: 0.36,
        jitter: 0.16,
        simulation_frequency: 18000
    )

    // 87.5mm x 94.0mm, 2261cc, ~9.5:1 compression -- real 2.3L EcoBoost
    // (Sigma/Mustang-and-Focus-RS-shared) dimensions.
    label stroke(94.0 * units.mm)
    label bore(87.5 * units.mm)
    label rod_length(143.5 * units.mm)
    label rod_mass(560 * units.g)
    label compression_height(30.0 * units.mm)
    label crank_mass(15 * units.kg)
    label flywheel_mass(7 * units.kg)
    label flywheel_radius(6.0 * units.inch)

    label crank_moment(
        disk_moment_of_inertia(mass: crank_mass, radius: stroke / 2)
    )
    label flywheel_moment(
        disk_moment_of_inertia(mass: flywheel_mass, radius: flywheel_radius)
    )
    label other_moment(
        disk_moment_of_inertia(mass: 8 * units.kg, radius: 6.5 * units.cm)
    )

    crankshaft c0(
        throw: stroke / 2,
        flywheel_mass: flywheel_mass,
        mass: crank_mass,
        friction_torque: 3.5 * units.lb_ft,
        moment_of_inertia:
            crank_moment + flywheel_moment + other_moment,
        position_x: 0.0,
        position_y: 0.0,
        tdc: 90 * units.deg
    )

    rod_journal rj0(angle: 0.0 * units.deg)
    rod_journal rj1(angle: 180.0 * units.deg)
    rod_journal rj2(angle: 180.0 * units.deg)
    rod_journal rj3(angle: 0.0 * units.deg)
    c0
        .add_rod_journal(rj0)
        .add_rod_journal(rj1)
        .add_rod_journal(rj2)
        .add_rod_journal(rj3)

    piston_parameters piston_params(
        mass: 360 * units.g,
        compression_height: compression_height,
        wrist_pin_position: 0.0,
        displacement: 0.0
    )

    connecting_rod_parameters cr_params(
        mass: rod_mass,
        moment_of_inertia: rod_moment_of_inertia(
            mass: rod_mass,
            length: rod_length
        ),
        center_of_mass: 0.0,
        length: rod_length
    )

    intake intake(
        plenum_volume: 2.0 * units.L,
        plenum_cross_section_area: 14.0 * units.cm2,
        intake_flow_rate: k_carb(1400.0),
        runner_flow_rate: k_carb(520.0),
        runner_length: 7.0 * units.inch,
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 0.9982,
        velocity_decay: 0.5,
        audio_volume: 3.0,
        impulse_response: ir_lib.mild_exhaust_0
    )

    exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(1500.0),
        primary_tube_length: 16.0 * units.inch,
        primary_flow_rate: k_carb(380.0),
        velocity_decay: 1.0,
        volume: 22.0 * units.L
    )

    exhaust_system exhaust0(
        es_params,
        audio_volume: 8 * 0.8,
        impulse_response: ir_lib.mild_exhaust_0
    )
    exhaust_system exhaust1(
        es_params,
        audio_volume: 8 * 1.0,
        impulse_response: ir_lib.mild_exhaust_0
    )

    cylinder_bank_parameters bank_params(
        bore: bore,
        deck_height: stroke / 2 + rod_length + compression_height
    )

    cylinder_bank b0(bank_params, angle: 0.0 * units.deg)
    b0
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire1,
            sound_attenuation: 0.9
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire2,
            sound_attenuation: 1.1
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire3,
            sound_attenuation: 0.8
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj3,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire4,
            sound_attenuation: 0.9
        )

    engine
        .add_cylinder_bank(b0)

    engine.add_crankshaft(c0)

    harmonic_cam_lobe intake_lobe(
        duration_at_50_thou: 208 * units.deg,
        gamma: 1.05,
        lift: 9.6 * units.mm,
        steps: 100
    )

    harmonic_cam_lobe exhaust_lobe(
        duration_at_50_thou: 202 * units.deg,
        gamma: 1.05,
        lift: 9.1 * units.mm,
        steps: 100
    )

    eb23_camshaft_builder camshaft(
        lobe_profile: "N/A",
        intake_lobe_profile: intake_lobe,
        exhaust_lobe_profile: exhaust_lobe,
        intake_lobe_center: 112 * units.deg,
        exhaust_lobe_center: 112 * units.deg,
        base_radius: 17.0 * units.mm
    )

    b0.set_cylinder_head(
        eb23_head(
            intake_camshaft: camshaft.intake_cam,
            exhaust_camshaft: camshaft.exhaust_cam
        )
    )

    // Turbo engine under boost tends to run a flatter, more conservative
    // timing curve than an NA engine of similar redline (knock-limited).
    function timing_curve(1000 * units.rpm)
    timing_curve
        .add_sample(0000 * units.rpm, 8 * units.deg)
        .add_sample(1000 * units.rpm, 12 * units.deg)
        .add_sample(2000 * units.rpm, 16 * units.deg)
        .add_sample(3000 * units.rpm, 18 * units.deg)
        .add_sample(4000 * units.rpm, 18 * units.deg)
        .add_sample(5000 * units.rpm, 16 * units.deg)
        .add_sample(6000 * units.rpm, 14 * units.deg)
        .add_sample(6800 * units.rpm, 12 * units.deg)

    ignition_module ignition_module(
        timing_curve: timing_curve,
        rev_limit: 6900 * units.rpm,
        limiter_duration: 0.045
    )
    ignition_module
        .connect_wire(wires.wire1, (0.0 / 4.0) * cycle)
        .connect_wire(wires.wire3, (3.0 / 4.0) * cycle)
        .connect_wire(wires.wire4, (2.0 / 4.0) * cycle)
        .connect_wire(wires.wire2, (1.0 / 4.0) * cycle)

    engine.add_ignition_module(ignition_module)
}

// Focus RS spec: single larger twin-scroll turbo than the Mustang's stock
// unit, run to ~350hp/350lb-ft (vs. the Mustang EcoBoost's stock ~310hp).
private node eb23_turbo {
    alias output __out: base.turbo_engine;

    eb23_na base()

    turbocharger turbo(
        intake: base.turbo_intake,
        turbine_flow_rate: k_carb(210.0),
        turbine_inertia: 0.00004,
        turbine_efficiency: 0.68,
        compressor_efficiency: 0.75,
        max_boost: 23.0 * units.psi,
        spool_speed: 105000.0 * units.rpm,
        bov_sound: bov_lib.bovaftermarket6
    )
    turbo
        .add_exhaust_system(base.turbo_exhaust0)
        .add_exhaust_system(base.turbo_exhaust1)

    base.turbo_engine.add_turbocharger(turbo)
}

// 2016+ Focus RS (Mk3), AWD -- treated here as a single-driveline vehicle
// (no front/rear torque split modeled), curb weight and a final drive
// approximating the real car's effective gearing.
private node eb23_rs_vehicle {
    alias output __out:
        vehicle(
            mass: 3434 * units.lb,
            drag_coefficient: 0.35,
            cross_sectional_area: (69 * units.inch) * (54 * units.inch),
            diff_ratio: 3.29,
            tire_radius: 12.4 * units.inch,
            rolling_resistance: 420 * units.N
        );
}

// 6-speed Getrag B6 manual (RS-spec ratios, only gearbox the Focus RS was
// offered with). Approximate published ratios.
private node eb23_rs_transmission {
    alias output __out:
        transmission(
            max_clutch_torque: 420 * units.lb_ft,
            type: "manual"
        )
        .add_gear(3.308)
        .add_gear(2.132)
        .add_gear(1.481)
        .add_gear(1.087)
        .add_gear(0.851)
        .add_gear(0.653);
}

public node main {
    set_engine(eb23_turbo())
    set_vehicle(eb23_rs_vehicle())
    set_transmission(eb23_rs_transmission())
}
