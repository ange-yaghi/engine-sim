import "engine_sim.mr"

units units()
constants constants()
impulse_response_library ir_lib()
bov_sound_library bov_lib()
label cycle(2 * 360 * units.deg)

// Mitsubishi 4G63T -- the 2.0L turbo inline-4 out of the Lancer Evolution
// VIII/IX. Famous for its long-rod, oversquare-in-stroke bottom end (a
// notably long stroke relative to bore for a sport-compact four) and its
// single big-frame turbo (TD05H-16G on the Evo VIII, larger 20G on the
// Evo IX MR) rather than a twin-turbo setup.

private node wires {
    output wire1: ignition_wire();
    output wire2: ignition_wire();
    output wire3: ignition_wire();
    output wire4: ignition_wire();
}

private node g63_camshaft_builder {
    input lobe_profile;
    input intake_lobe_profile: lobe_profile;
    input exhaust_lobe_profile: lobe_profile;
    input lobe_separation: 114 * units.deg;
    input intake_lobe_center: lobe_separation;
    input exhaust_lobe_center: lobe_separation;
    input advance: 0 * units.deg;
    input base_radius: 17.0 * units.mm;

    output intake_cam: _intake_cam;
    output exhaust_cam: _exhaust_cam;

    camshaft_parameters params(
        advance: advance,
        base_radius: base_radius
    )

    // MIVEC -- intake-only cam phasing, added for the Evo IX (Evo VIII
    // ran a fixed intake cam; this file already covers both per its own
    // header, so the IX's MIVEC is modeled here).
    function intake_vvt(1000 * units.rpm)
    intake_vvt
        .add_sample(0000 * units.rpm, 0 * units.deg)
        .add_sample(2500 * units.rpm, 12 * units.deg)
        .add_sample(5000 * units.rpm, 16 * units.deg)
        .add_sample(7000 * units.rpm, 8 * units.deg)

    camshaft _intake_cam(params, lobe_profile: intake_lobe_profile, advance_curve: intake_vvt)
    camshaft _exhaust_cam(params, lobe_profile: exhaust_lobe_profile)

    label rot360(360 * units.deg)

    // Firing order 1-3-4-2
    _exhaust_cam
        .add_lobe(rot360 + exhaust_lobe_center - (0.0 / 4) * cycle)
        .add_lobe(rot360 + exhaust_lobe_center - (3.0 / 4) * cycle)
        .add_lobe(rot360 + exhaust_lobe_center - (1.0 / 4) * cycle)
        .add_lobe(rot360 + exhaust_lobe_center - (2.0 / 4) * cycle)
    _intake_cam
        .add_lobe(rot360 - intake_lobe_center - (0.0 / 4) * cycle)
        .add_lobe(rot360 - intake_lobe_center - (3.0 / 4) * cycle)
        .add_lobe(rot360 - intake_lobe_center - (1.0 / 4) * cycle)
        .add_lobe(rot360 - intake_lobe_center - (2.0 / 4) * cycle)
}

private node g63_head {
    input intake_camshaft;
    input exhaust_camshaft;
    input chamber_volume: 47.0 * units.cc;
    input intake_runner_volume: 95.0 * units.cc;
    input intake_runner_cross_section_area: 1.4 * units.inch * 1.4 * units.inch;
    input exhaust_runner_volume: 42.0 * units.cc;
    input exhaust_runner_cross_section_area: 1.25 * units.inch * 1.25 * units.inch;

    input flow_attenuation: 1.0;
    input lift_scale: 1.0;
    input flip_display: false;
    alias output __out: head;

    function intake_flow(50 * units.thou)
    intake_flow
        .add_flow_sample(0 * lift_scale, 0 * flow_attenuation)
        .add_flow_sample(50 * lift_scale, 53 * flow_attenuation)
        .add_flow_sample(100 * lift_scale, 97 * flow_attenuation)
        .add_flow_sample(150 * lift_scale, 147 * flow_attenuation)
        .add_flow_sample(200 * lift_scale, 193 * flow_attenuation)
        .add_flow_sample(250 * lift_scale, 227 * flow_attenuation)
        .add_flow_sample(300 * lift_scale, 245 * flow_attenuation)
        .add_flow_sample(350 * lift_scale, 254 * flow_attenuation)
        .add_flow_sample(400 * lift_scale, 258 * flow_attenuation)
        .add_flow_sample(450 * lift_scale, 259 * flow_attenuation)

    function exhaust_flow(50 * units.thou)
    exhaust_flow
        .add_flow_sample(0 * lift_scale, 0 * flow_attenuation)
        .add_flow_sample(50 * lift_scale, 43 * flow_attenuation)
        .add_flow_sample(100 * lift_scale, 79 * flow_attenuation)
        .add_flow_sample(150 * lift_scale, 121 * flow_attenuation)
        .add_flow_sample(200 * lift_scale, 159 * flow_attenuation)
        .add_flow_sample(250 * lift_scale, 187 * flow_attenuation)
        .add_flow_sample(300 * lift_scale, 207 * flow_attenuation)
        .add_flow_sample(350 * lift_scale, 217 * flow_attenuation)
        .add_flow_sample(400 * lift_scale, 222 * flow_attenuation)
        .add_flow_sample(450 * lift_scale, 223 * flow_attenuation)

    generic_cylinder_head head(
        chamber_volume: chamber_volume,
        intake_runner_volume: intake_runner_volume,
        intake_runner_cross_section_area: intake_runner_cross_section_area,
        exhaust_runner_volume: exhaust_runner_volume,
        exhaust_runner_cross_section_area: exhaust_runner_cross_section_area,

        intake_port_flow: intake_flow,
        exhaust_port_flow: exhaust_flow,
        valvetrain: standard_valvetrain(
            intake_camshaft: intake_camshaft,
            exhaust_camshaft: exhaust_camshaft
        ),
        flip_display: flip_display
    )
}

public node g63_na {
    output turbo_engine: engine;
    output turbo_intake: intake;
    output turbo_exhaust0: exhaust0;
    output turbo_exhaust1: exhaust1;

    wires wires()

    engine engine(
        name: "Mitsubishi 4G63T [Lancer Evolution VIII/IX]",
        starter_torque: 65 * units.lb_ft,
        starter_speed: -400 * units.rpm,
        redline: 7000 * units.rpm,
        fuel: fuel(
            max_turbulence_effect: 3.0,
            max_burning_efficiency: 0.82
        ),
        throttle_gamma: 2.0,
        hf_gain: 0.004,
        noise: 0.35,
        jitter: 0.17,
        simulation_frequency: 18000
    )

    // 85.0mm x 88.0mm, 1997cc, ~8.8:1 compression -- real 4G63T dimensions
    // (long-stroke relative to bore for a sport-compact four).
    label stroke(88.0 * units.mm)
    label bore(85.0 * units.mm)
    label rod_length(150.0 * units.mm)
    label rod_mass(480 * units.g)
    label compression_height(28.5 * units.mm)
    label crank_mass(13 * units.kg)
    label flywheel_mass(6 * units.kg)
    label flywheel_radius(5.8 * units.inch)

    label crank_moment(
        disk_moment_of_inertia(mass: crank_mass, radius: stroke / 2)
    )
    label flywheel_moment(
        disk_moment_of_inertia(mass: flywheel_mass, radius: flywheel_radius)
    )
    label other_moment(
        disk_moment_of_inertia(mass: 7 * units.kg, radius: 6.0 * units.cm)
    )

    crankshaft c0(
        throw: stroke / 2,
        flywheel_mass: flywheel_mass,
        mass: crank_mass,
        friction_torque: 3.0 * units.lb_ft,
        moment_of_inertia:
            crank_moment + flywheel_moment + other_moment,
        position_x: 0.0,
        position_y: 0.0,
        tdc: 90 * units.deg
    )

    rod_journal rj0(angle: 0.0 * units.deg)
    rod_journal rj1(angle: 180.0 * units.deg)
    rod_journal rj2(angle: 180.0 * units.deg)
    rod_journal rj3(angle: 0.0 * units.deg)
    c0
        .add_rod_journal(rj0)
        .add_rod_journal(rj1)
        .add_rod_journal(rj2)
        .add_rod_journal(rj3)

    piston_parameters piston_params(
        mass: 320 * units.g,
        compression_height: compression_height,
        wrist_pin_position: 0.0,
        displacement: 0.0
    )

    connecting_rod_parameters cr_params(
        mass: rod_mass,
        moment_of_inertia: rod_moment_of_inertia(
            mass: rod_mass,
            length: rod_length
        ),
        center_of_mass: 0.0,
        length: rod_length
    )

    intake intake(
        plenum_volume: 1.1 * units.L,
        plenum_cross_section_area: 12.0 * units.cm2,
        intake_flow_rate: k_carb(720.0),
        runner_flow_rate: k_carb(250.0),
        runner_length: 6.5 * units.inch,
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 0.9985,
        velocity_decay: 0.5,
        audio_volume: 3.0,
        impulse_response: ir_lib.mild_exhaust_0
    )

    exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(880.0),
        primary_tube_length: 17.0 * units.inch,
        primary_flow_rate: k_carb(190.0),
        velocity_decay: 1.0,
        volume: 24.0 * units.L
    )

    exhaust_system exhaust0(
        es_params,
        audio_volume: 8 * 0.8,
        impulse_response: ir_lib.mild_exhaust_0
    )
    exhaust_system exhaust1(
        es_params,
        audio_volume: 8 * 1.0,
        impulse_response: ir_lib.mild_exhaust_0
    )

    cylinder_bank_parameters bank_params(
        bore: bore,
        deck_height: stroke / 2 + rod_length + compression_height
    )

    cylinder_bank b0(bank_params, angle: 0.0 * units.deg)
    b0
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire1,
            sound_attenuation: 0.9
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire2,
            sound_attenuation: 1.1
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire3,
            sound_attenuation: 0.8
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj3,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire4,
            sound_attenuation: 0.9
        )

    engine
        .add_cylinder_bank(b0)

    engine.add_crankshaft(c0)

    harmonic_cam_lobe intake_lobe(
        duration_at_50_thou: 220 * units.deg,
        gamma: 1.05,
        lift: 9.3 * units.mm,
        steps: 100
    )

    harmonic_cam_lobe exhaust_lobe(
        duration_at_50_thou: 216 * units.deg,
        gamma: 1.05,
        lift: 9.0 * units.mm,
        steps: 100
    )

    g63_camshaft_builder camshaft(
        lobe_profile: "N/A",
        intake_lobe_profile: intake_lobe,
        exhaust_lobe_profile: exhaust_lobe,
        intake_lobe_center: 114 * units.deg,
        exhaust_lobe_center: 114 * units.deg,
        base_radius: 17.0 * units.mm
    )

    b0.set_cylinder_head(
        g63_head(
            intake_camshaft: camshaft.intake_cam,
            exhaust_camshaft: camshaft.exhaust_cam
        )
    )

    function timing_curve(1000 * units.rpm)
    timing_curve
        .add_sample(0000 * units.rpm, 10 * units.deg)
        .add_sample(1000 * units.rpm, 14 * units.deg)
        .add_sample(2000 * units.rpm, 18 * units.deg)
        .add_sample(3000 * units.rpm, 22 * units.deg)
        .add_sample(4000 * units.rpm, 24 * units.deg)
        .add_sample(5000 * units.rpm, 24 * units.deg)
        .add_sample(6000 * units.rpm, 22 * units.deg)
        .add_sample(7000 * units.rpm, 20 * units.deg)

    ignition_module ignition_module(
        timing_curve: timing_curve,
        rev_limit: 7200 * units.rpm,
        limiter_duration: 0.05
    )
    ignition_module
        .connect_wire(wires.wire1, (0.0 / 4.0) * cycle)
        .connect_wire(wires.wire3, (3.0 / 4.0) * cycle)
        .connect_wire(wires.wire4, (2.0 / 4.0) * cycle)
        .connect_wire(wires.wire2, (1.0 / 4.0) * cycle)

    engine.add_ignition_module(ignition_module)
}

// Single big-frame turbo (TD05H-16G-class) -- unlike the 2JZ-GTE/RB26DETT in
// this batch, the 4G63T is not twin-turbo.
private node g63_single_turbo {
    alias output __out: base.turbo_engine;

    g63_na base()

    turbocharger turbo(
        intake: base.turbo_intake,
        turbine_flow_rate: k_carb(180.0),
        turbine_inertia: 0.00004,
        turbine_efficiency: 0.68,
        compressor_efficiency: 0.74,
        max_boost: 24.0 * units.psi,
        spool_speed: 150000.0 * units.rpm,
        bov_sound: bov_lib.bovaftermarket2
    )
    turbo
        .add_exhaust_system(base.turbo_exhaust0)
        .add_exhaust_system(base.turbo_exhaust1)

    base.turbo_engine.add_turbocharger(turbo)
}

private node g63_vehicle {
    alias output __out:
        vehicle(
            mass: 3200 * units.lb,
            drag_coefficient: 0.33,
            cross_sectional_area: (68 * units.inch) * (55 * units.inch),
            diff_ratio: 4.529,
            tire_radius: 11.6 * units.inch,
            rolling_resistance: 380 * units.N
        );
}

// 5-speed W5M33 (Evo VIII manual). Real stock ratios.
private node g63_transmission {
    alias output __out:
        transmission(
            max_clutch_torque: 310 * units.lb_ft,
            type: "manual"
        )
        .add_gear(3.320)
        .add_gear(2.090)
        .add_gear(1.481)
        .add_gear(1.166)
        .add_gear(0.916);
}

public node main {
    set_engine(g63_single_turbo())
    set_vehicle(g63_vehicle())
    set_transmission(g63_transmission())
}
