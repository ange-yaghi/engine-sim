import "engine_sim.mr"

units units()
constants constants()
impulse_response_library ir_lib()
bov_sound_library bov_lib()
label cycle(2 * 360 * units.deg)

// Bugatti/Volkswagen 8.0L W16 quad-turbo (Veyron 16.4, 2005-2015). Bore and
// stroke are both 86.0mm (square), giving 499.5cc/cyl, 7992cc total
// (matches the real ~8.0L). Compression 9.3:1 is the commonly cited factory
// figure -- modest by NA standards, appropriate for a heavily boosted
// application. Real-world output (base 16.4, not Super Sport) ~1001PS
// (987hp/736kW) @ 6000rpm, ~922lb-ft (1250Nm) across a wide 2200-5500rpm
// plateau. Redline/fuel-cut approximated at 6500/6600rpm.
//
// Architecture -- same "two narrow-angle halves joined at a wider W angle"
// family as passat_w8.mr, one size up: each half is a VR8 (a narrow-angle
// 15deg pair of 4-cylinder banks, i.e. an 8-cylinder VR6-style unit)
// instead of a VR4, so the whole engine is 4 banks of 4 cylinders (16
// total) instead of w8.mr's 4 banks of 2. This file reuses w8.mr's exact
// bank-angle numbers (15deg narrow angle, approximated 72deg between the
// two VR8 halves' centerlines) since it's the same underlying architecture
// family -- see w8.mr's header for the caveat on that 72deg figure being
// this file's best-effort reconstruction, not a confirmed factory spec.
//
// Same reasoning as vr6.mr/w8.mr applies to the crank: no rod_journal is
// shared between any two cylinders, anywhere in this file. All 16 get an
// independent journal. (This simulation's kinematics are purely angular --
// it has no notion of a cylinder's position along the crankshaft's length
// at all -- so, as in w8.mr, "independent" here is about the angle number
// each cylinder gets, not a claim about the real forged crank's actual
// physical throw count, which this file isn't confident enough about to
// assert either way.)
//
// Firing order -- derived from crank geometry (same
// TDC = P - tdc + bankAngle + 90deg method as vr6.mr/w8.mr, verified
// against this sim's crankshaft.cpp/connecting_rod.cpp/ignition_module.cpp
// source), not copied from a real-world citation. Reference bank bankA1
// (-43.5deg, cylinders 1-3-5-7) sets tdc = 90 - 43.5 = 46.5deg -- identical
// to w8.mr's tdc, since it's the same bank-angle layout. Cylinder-to-bank
// convention: cylinders 1-8 alternate banks A1/A2 (the "left" VR8 half),
// 9-16 alternate banks B1/B2 (the "right" VR8 half). Chosen firing order
// (alternates VR8 half every step, alternates bank within each half):
// 1-9-2-10-3-11-4-12-5-13-6-14-7-15-8-16, evenly spaced 45deg apart
// (720/16). Solving rj.angle = P + bankAngle + 43.5 (the "-tdc+90" constant
// simplifies to +43.5, same derivation as w8.mr) per cylinder:
//   cyl1  (A1 -43.5, P=0):   0 - 43.5 + 43.5 = 0
//   cyl2  (A2 -28.5, P=90):  90 - 28.5 + 43.5 = 105
//   cyl3  (A1 -43.5, P=180): 180 - 43.5 + 43.5 = 180
//   cyl4  (A2 -28.5, P=270): 270 - 28.5 + 43.5 = 285
//   cyl5  (A1 -43.5, P=360): 360 - 43.5 + 43.5 = 360
//   cyl6  (A2 -28.5, P=450): 450 - 28.5 + 43.5 = 465
//   cyl7  (A1 -43.5, P=540): 540 - 43.5 + 43.5 = 540
//   cyl8  (A2 -28.5, P=630): 630 - 28.5 + 43.5 = 645
//   cyl9  (B1 +28.5, P=45):  45 + 28.5 + 43.5 = 117
//   cyl10 (B2 +43.5, P=135): 135 + 43.5 + 43.5 = 222
//   cyl11 (B1 +28.5, P=225): 225 + 28.5 + 43.5 = 297
//   cyl12 (B2 +43.5, P=315): 315 + 43.5 + 43.5 = 402
//   cyl13 (B1 +28.5, P=405): 405 + 28.5 + 43.5 = 477
//   cyl14 (B2 +43.5, P=495): 495 + 43.5 + 43.5 = 582
//   cyl15 (B1 +28.5, P=585): 585 + 28.5 + 43.5 = 657
//   cyl16 (B2 +43.5, P=675): 675 + 43.5 + 43.5 = 762
//
// Forced induction -- four turbochargers, one per bank (each fed only by
// its own bank's 4-cylinder exhaust manifold), all four compressors merging
// into one shared central intake plenum -- same "independently-fed
// turbos into one shared plenum" topology this repo's twin-turbo sixes
// (rb26dett.mr, 2jzgte.mr) use, just extended to four.

private node wires {
    output wire1: ignition_wire();
    output wire2: ignition_wire();
    output wire3: ignition_wire();
    output wire4: ignition_wire();
    output wire5: ignition_wire();
    output wire6: ignition_wire();
    output wire7: ignition_wire();
    output wire8: ignition_wire();
    output wire9: ignition_wire();
    output wire10: ignition_wire();
    output wire11: ignition_wire();
    output wire12: ignition_wire();
    output wire13: ignition_wire();
    output wire14: ignition_wire();
    output wire15: ignition_wire();
    output wire16: ignition_wire();
}

private node w16_head {
    input intake_camshaft;
    input exhaust_camshaft;
    input chamber_volume;
    input intake_runner_volume: 78.0 * units.cc;
    input intake_runner_cross_section_area: 1.05 * units.inch * 1.05 * units.inch;
    input exhaust_runner_volume: 32.0 * units.cc;
    input exhaust_runner_cross_section_area: 0.98 * units.inch * 0.98 * units.inch;

    input flow_attenuation: 1.0;
    input lift_scale: 1.0;
    input flip_display: false;
    alias output __out: head;

    // Approximated flow bench numbers (not a real flow sheet) -- a mild,
    // low-stress head (most of this engine's output comes from boost, not
    // an aggressive NA-style port), tuned to land dyno peak in the real
    // ~1001PS/922lb-ft ballpark once the turbos below are added.
    function intake_flow(50 * units.thou)
    intake_flow
        .add_flow_sample(0 * lift_scale, 0 * flow_attenuation)
        .add_flow_sample(50 * lift_scale, 33 * flow_attenuation)
        .add_flow_sample(100 * lift_scale, 61 * flow_attenuation)
        .add_flow_sample(150 * lift_scale, 92 * flow_attenuation)
        .add_flow_sample(200 * lift_scale, 121 * flow_attenuation)
        .add_flow_sample(250 * lift_scale, 143 * flow_attenuation)
        .add_flow_sample(300 * lift_scale, 154 * flow_attenuation)
        .add_flow_sample(350 * lift_scale, 160 * flow_attenuation)
        .add_flow_sample(400 * lift_scale, 163 * flow_attenuation)
        .add_flow_sample(450 * lift_scale, 164 * flow_attenuation)

    function exhaust_flow(50 * units.thou)
    exhaust_flow
        .add_flow_sample(0 * lift_scale, 0 * flow_attenuation)
        .add_flow_sample(50 * lift_scale, 26 * flow_attenuation)
        .add_flow_sample(100 * lift_scale, 49 * flow_attenuation)
        .add_flow_sample(150 * lift_scale, 74 * flow_attenuation)
        .add_flow_sample(200 * lift_scale, 97 * flow_attenuation)
        .add_flow_sample(250 * lift_scale, 115 * flow_attenuation)
        .add_flow_sample(300 * lift_scale, 126 * flow_attenuation)
        .add_flow_sample(350 * lift_scale, 131 * flow_attenuation)
        .add_flow_sample(400 * lift_scale, 134 * flow_attenuation)
        .add_flow_sample(450 * lift_scale, 135 * flow_attenuation)

    generic_cylinder_head head(
        chamber_volume: chamber_volume,
        intake_runner_volume: intake_runner_volume,
        intake_runner_cross_section_area: intake_runner_cross_section_area,
        exhaust_runner_volume: exhaust_runner_volume,
        exhaust_runner_cross_section_area: exhaust_runner_cross_section_area,

        intake_port_flow: intake_flow,
        exhaust_port_flow: exhaust_flow,
        valvetrain: standard_valvetrain(
            intake_camshaft: intake_camshaft,
            exhaust_camshaft: exhaust_camshaft
        ),
        flip_display: flip_display
    )
}

private node w16_camshaft {
    input lobe_profile;
    input intake_lobe_profile: lobe_profile;
    input exhaust_lobe_profile: lobe_profile;
    input lobe_separation: 112.0 * units.deg;
    input intake_lobe_center: lobe_separation;
    input exhaust_lobe_center: lobe_separation;
    input advance: 0.0 * units.deg;
    input base_radius: 0.68 * units.inch;

    // One intake/exhaust cam pair per bank -- 4 banks, no sharing (each
    // bank has its own 4 cylinders and its own pair of cams).
    output intake_cam_a1: _intake_cam_a1;
    output exhaust_cam_a1: _exhaust_cam_a1;
    output intake_cam_a2: _intake_cam_a2;
    output exhaust_cam_a2: _exhaust_cam_a2;
    output intake_cam_b1: _intake_cam_b1;
    output exhaust_cam_b1: _exhaust_cam_b1;
    output intake_cam_b2: _intake_cam_b2;
    output exhaust_cam_b2: _exhaust_cam_b2;

    camshaft_parameters params(
        advance: advance,
        base_radius: base_radius
    )

    camshaft _intake_cam_a1(params, lobe_profile: intake_lobe_profile)
    camshaft _exhaust_cam_a1(params, lobe_profile: exhaust_lobe_profile)
    camshaft _intake_cam_a2(params, lobe_profile: intake_lobe_profile)
    camshaft _exhaust_cam_a2(params, lobe_profile: exhaust_lobe_profile)
    camshaft _intake_cam_b1(params, lobe_profile: intake_lobe_profile)
    camshaft _exhaust_cam_b1(params, lobe_profile: exhaust_lobe_profile)
    camshaft _intake_cam_b2(params, lobe_profile: intake_lobe_profile)
    camshaft _exhaust_cam_b2(params, lobe_profile: exhaust_lobe_profile)

    label rot(45.0 * units.deg) // firing interval, 720 / 16
    label rot360(360 * units.deg)

    // Cam lobe placement mirrors the ignition wiring below exactly: each
    // cylinder's rot-multiplier is its position (0-15) in the derived
    // firing order 1-9-2-10-3-11-4-12-5-13-6-14-7-15-8-16 (see file
    // header). Lobes are added in each bank's own physical front-to-back
    // cylinder order, not firing order.
    //
    // bankA1 (cyl 1, 3, 5, 7): positions 0, 4, 8, 12
    _exhaust_cam_a1
        .add_lobe(rot360 - exhaust_lobe_center + 0 * rot)  // 1
        .add_lobe(rot360 - exhaust_lobe_center + 4 * rot)  // 3
        .add_lobe(rot360 - exhaust_lobe_center + 8 * rot)  // 5
        .add_lobe(rot360 - exhaust_lobe_center + 12 * rot) // 7
    _intake_cam_a1
        .add_lobe(rot360 + intake_lobe_center + 0 * rot)  // 1
        .add_lobe(rot360 + intake_lobe_center + 4 * rot)  // 3
        .add_lobe(rot360 + intake_lobe_center + 8 * rot)  // 5
        .add_lobe(rot360 + intake_lobe_center + 12 * rot) // 7

    // bankA2 (cyl 2, 4, 6, 8): positions 2, 6, 10, 14
    _exhaust_cam_a2
        .add_lobe(rot360 - exhaust_lobe_center + 2 * rot)  // 2
        .add_lobe(rot360 - exhaust_lobe_center + 6 * rot)  // 4
        .add_lobe(rot360 - exhaust_lobe_center + 10 * rot) // 6
        .add_lobe(rot360 - exhaust_lobe_center + 14 * rot) // 8
    _intake_cam_a2
        .add_lobe(rot360 + intake_lobe_center + 2 * rot)  // 2
        .add_lobe(rot360 + intake_lobe_center + 6 * rot)  // 4
        .add_lobe(rot360 + intake_lobe_center + 10 * rot) // 6
        .add_lobe(rot360 + intake_lobe_center + 14 * rot) // 8

    // bankB1 (cyl 9, 11, 13, 15): positions 1, 5, 9, 13
    _exhaust_cam_b1
        .add_lobe(rot360 - exhaust_lobe_center + 1 * rot)  // 9
        .add_lobe(rot360 - exhaust_lobe_center + 5 * rot)  // 11
        .add_lobe(rot360 - exhaust_lobe_center + 9 * rot)  // 13
        .add_lobe(rot360 - exhaust_lobe_center + 13 * rot) // 15
    _intake_cam_b1
        .add_lobe(rot360 + intake_lobe_center + 1 * rot)  // 9
        .add_lobe(rot360 + intake_lobe_center + 5 * rot)  // 11
        .add_lobe(rot360 + intake_lobe_center + 9 * rot)  // 13
        .add_lobe(rot360 + intake_lobe_center + 13 * rot) // 15

    // bankB2 (cyl 10, 12, 14, 16): positions 3, 7, 11, 15
    _exhaust_cam_b2
        .add_lobe(rot360 - exhaust_lobe_center + 3 * rot)  // 10
        .add_lobe(rot360 - exhaust_lobe_center + 7 * rot)  // 12
        .add_lobe(rot360 - exhaust_lobe_center + 11 * rot) // 14
        .add_lobe(rot360 - exhaust_lobe_center + 15 * rot) // 16
    _intake_cam_b2
        .add_lobe(rot360 + intake_lobe_center + 3 * rot)  // 10
        .add_lobe(rot360 + intake_lobe_center + 7 * rot)  // 12
        .add_lobe(rot360 + intake_lobe_center + 11 * rot) // 14
        .add_lobe(rot360 + intake_lobe_center + 15 * rot) // 16
}

private node veyron_w16_na {
    output turbo_engine: engine;
    output turbo_intake: intake;
    output turbo_exhaust0: exhaust0;
    output turbo_exhaust1: exhaust1;
    output turbo_exhaust2: exhaust2;
    output turbo_exhaust3: exhaust3;

    wires wires()

    engine engine(
        name: "Bugatti/Volkswagen 8.0L W16 Quad-Turbo [Veyron 16.4]",
        starter_torque: 220 * units.lb_ft,
        starter_speed: 250 * units.rpm,
        redline: 6500 * units.rpm,
        throttle_gamma: 2.0,
        hf_gain: 0.005,
        noise: 0.4,
        jitter: 0.16,
        simulation_frequency: 9000
    )

    // 86.0mm x 86.0mm (square) -> 499.5cc/cyl, 7992cc total (~8.0L). 9.3:1
    // compression is the commonly cited factory figure.
    label stroke(86.0 * units.mm)
    label bore(86.0 * units.mm)
    label rod_length(145.0 * units.mm) // approximated, not from spec
    label rod_mass(430 * units.g) // approximated, not from spec
    label compression_height(25.0 * units.mm) // approximated, not from spec
    label compression_ratio(9.3)
    label chamber_volume(
        (circle_area(bore / 2) * stroke) / (compression_ratio - 1)
    )

    label crank_mass(35 * units.kg) // approximated -- big 16-throw crank
    label flywheel_mass(10 * units.kg) // DSG dual-mass flywheel/damper
    label flywheel_radius(5.5 * units.inch)

    label crank_moment(
        disk_moment_of_inertia(mass: crank_mass, radius: stroke / 2)
    )
    label flywheel_moment(
        disk_moment_of_inertia(mass: flywheel_mass, radius: flywheel_radius)
    )
    label other_moment( // cams, chains, accessories, etc [estimated]
        disk_moment_of_inertia(mass: 20 * units.kg, radius: 8.0 * units.cm)
    )

    label narrow_angle(15 * units.deg) // VR8-half internal angle (matches VR6/W8)
    label w_angle(72 * units.deg) // approximated angle between the two VR8 halves

    label bank_a1_angle(-(w_angle / 2.0) - (narrow_angle / 2.0)) // -43.5deg
    label bank_a2_angle(-(w_angle / 2.0) + (narrow_angle / 2.0)) // -28.5deg
    label bank_b1_angle((w_angle / 2.0) - (narrow_angle / 2.0))  // +28.5deg
    label bank_b2_angle((w_angle / 2.0) + (narrow_angle / 2.0))  // +43.5deg

    crankshaft c0(
        throw: stroke / 2,
        flywheel_mass: flywheel_mass,
        mass: crank_mass,
        friction_torque: 14.0 * units.lb_ft,
        moment_of_inertia:
            crank_moment + flywheel_moment + other_moment,
        position_x: 0.0,
        position_y: 0.0,
        tdc: 90 * units.deg + bank_a1_angle
    )

    // Sixteen independent rod journals -- no sharing across (or within) any
    // bank. See file header for the geometry/derivation.
    rod_journal rj0(angle: 0 * units.deg)     // cyl 1
    rod_journal rj1(angle: 105 * units.deg)   // cyl 2
    rod_journal rj2(angle: 180 * units.deg)   // cyl 3
    rod_journal rj3(angle: 285 * units.deg)   // cyl 4
    rod_journal rj4(angle: 360 * units.deg)   // cyl 5
    rod_journal rj5(angle: 465 * units.deg)   // cyl 6
    rod_journal rj6(angle: 540 * units.deg)   // cyl 7
    rod_journal rj7(angle: 645 * units.deg)   // cyl 8
    rod_journal rj8(angle: 117 * units.deg)   // cyl 9
    rod_journal rj9(angle: 222 * units.deg)   // cyl 10
    rod_journal rj10(angle: 297 * units.deg)  // cyl 11
    rod_journal rj11(angle: 402 * units.deg)  // cyl 12
    rod_journal rj12(angle: 477 * units.deg)  // cyl 13
    rod_journal rj13(angle: 582 * units.deg)  // cyl 14
    rod_journal rj14(angle: 657 * units.deg)  // cyl 15
    rod_journal rj15(angle: 762 * units.deg)  // cyl 16
    c0
        .add_rod_journal(rj0)
        .add_rod_journal(rj1)
        .add_rod_journal(rj2)
        .add_rod_journal(rj3)
        .add_rod_journal(rj4)
        .add_rod_journal(rj5)
        .add_rod_journal(rj6)
        .add_rod_journal(rj7)
        .add_rod_journal(rj8)
        .add_rod_journal(rj9)
        .add_rod_journal(rj10)
        .add_rod_journal(rj11)
        .add_rod_journal(rj12)
        .add_rod_journal(rj13)
        .add_rod_journal(rj14)
        .add_rod_journal(rj15)

    piston_parameters piston_params(
        mass: 350 * units.g,
        compression_height: compression_height,
        wrist_pin_position: 0.0,
        displacement: 0.0
    )

    connecting_rod_parameters cr_params(
        mass: rod_mass,
        moment_of_inertia: rod_moment_of_inertia(
            mass: rod_mass,
            length: rod_length
        ),
        center_of_mass: 0.0,
        length: rod_length
    )

    // Single shared plenum downstream of all four turbos.
    intake intake(
        plenum_volume: 3.0 * units.L,
        plenum_cross_section_area: 30.0 * units.cm2,
        intake_flow_rate: k_carb(2000.0),
        runner_flow_rate: k_carb(220.0),
        runner_length: 6.0 * units.inch,
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 0.998,
        velocity_decay: 0.5,
        audio_volume: 3.0,
        impulse_response: ir_lib.mild_exhaust_0
    )

    exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(700.0),
        primary_tube_length: 14.0 * units.inch,
        primary_flow_rate: k_carb(190.0),
        velocity_decay: 1.0,
        volume: 14.0 * units.L
    )

    // Four exhaust systems -- one per bank, each feeding only its own
    // turbo (see veyron_w16_quad_turbo below).
    exhaust_system exhaust0(
        es_params,
        audio_volume: 6.0,
        impulse_response: ir_lib.sharp_0
    )
    exhaust_system exhaust1(
        es_params,
        audio_volume: 6.0,
        impulse_response: ir_lib.sharp_0
    )
    exhaust_system exhaust2(
        es_params,
        audio_volume: 6.0,
        impulse_response: ir_lib.sharp_0
    )
    exhaust_system exhaust3(
        es_params,
        audio_volume: 6.0,
        impulse_response: ir_lib.sharp_0
    )

    cylinder_bank_parameters bank_params(
        bore: bore,
        deck_height: stroke / 2 + rod_length + compression_height
    )

    cylinder_bank bankA1(bank_params, angle: bank_a1_angle)
    cylinder_bank bankA2(bank_params, angle: bank_a2_angle)
    cylinder_bank bankB1(bank_params, angle: bank_b1_angle)
    cylinder_bank bankB2(bank_params, angle: bank_b2_angle)

    bankA1
        .add_cylinder( // cyl 1 (front)
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire1,
            sound_attenuation: 0.9,
            primary_length: 4 * units.cm
        )
        .add_cylinder( // cyl 3
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire3,
            sound_attenuation: 0.93,
            primary_length: 3 * units.cm
        )
        .add_cylinder( // cyl 5
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj4,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire5,
            sound_attenuation: 0.96,
            primary_length: 2 * units.cm
        )
        .add_cylinder( // cyl 7 (rear)
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj6,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire7,
            sound_attenuation: 1.0,
            primary_length: 1 * units.cm
        )
        .set_cylinder_head(
            w16_head(
                chamber_volume: chamber_volume,
                flip_display: false,
                intake_camshaft: camshaft.intake_cam_a1,
                exhaust_camshaft: camshaft.exhaust_cam_a1
            )
        )
    bankA2
        .add_cylinder( // cyl 2 (front)
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire2,
            sound_attenuation: 0.9,
            primary_length: 4 * units.cm
        )
        .add_cylinder( // cyl 4
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj3,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire4,
            sound_attenuation: 0.93,
            primary_length: 3 * units.cm
        )
        .add_cylinder( // cyl 6
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj5,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire6,
            sound_attenuation: 0.96,
            primary_length: 2 * units.cm
        )
        .add_cylinder( // cyl 8 (rear)
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj7,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire8,
            sound_attenuation: 1.0,
            primary_length: 1 * units.cm
        )
        .set_cylinder_head(
            w16_head(
                chamber_volume: chamber_volume,
                flip_display: true,
                intake_camshaft: camshaft.intake_cam_a2,
                exhaust_camshaft: camshaft.exhaust_cam_a2
            )
        )
    bankB1
        .add_cylinder( // cyl 9 (front)
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj8,
            intake: intake,
            exhaust_system: exhaust2,
            ignition_wire: wires.wire9,
            sound_attenuation: 0.9,
            primary_length: 4 * units.cm
        )
        .add_cylinder( // cyl 11
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj10,
            intake: intake,
            exhaust_system: exhaust2,
            ignition_wire: wires.wire11,
            sound_attenuation: 0.93,
            primary_length: 3 * units.cm
        )
        .add_cylinder( // cyl 13
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj12,
            intake: intake,
            exhaust_system: exhaust2,
            ignition_wire: wires.wire13,
            sound_attenuation: 0.96,
            primary_length: 2 * units.cm
        )
        .add_cylinder( // cyl 15 (rear)
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj14,
            intake: intake,
            exhaust_system: exhaust2,
            ignition_wire: wires.wire15,
            sound_attenuation: 1.0,
            primary_length: 1 * units.cm
        )
        .set_cylinder_head(
            w16_head(
                chamber_volume: chamber_volume,
                flip_display: false,
                intake_camshaft: camshaft.intake_cam_b1,
                exhaust_camshaft: camshaft.exhaust_cam_b1
            )
        )
    bankB2
        .add_cylinder( // cyl 10 (front)
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj9,
            intake: intake,
            exhaust_system: exhaust3,
            ignition_wire: wires.wire10,
            sound_attenuation: 0.9,
            primary_length: 4 * units.cm
        )
        .add_cylinder( // cyl 12
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj11,
            intake: intake,
            exhaust_system: exhaust3,
            ignition_wire: wires.wire12,
            sound_attenuation: 0.93,
            primary_length: 3 * units.cm
        )
        .add_cylinder( // cyl 14
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj13,
            intake: intake,
            exhaust_system: exhaust3,
            ignition_wire: wires.wire14,
            sound_attenuation: 0.96,
            primary_length: 2 * units.cm
        )
        .add_cylinder( // cyl 16 (rear)
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj15,
            intake: intake,
            exhaust_system: exhaust3,
            ignition_wire: wires.wire16,
            sound_attenuation: 1.0,
            primary_length: 1 * units.cm
        )
        .set_cylinder_head(
            w16_head(
                chamber_volume: chamber_volume,
                flip_display: true,
                intake_camshaft: camshaft.intake_cam_b2,
                exhaust_camshaft: camshaft.exhaust_cam_b2
            )
        )

    engine
        .add_cylinder_bank(bankA1)
        .add_cylinder_bank(bankA2)
        .add_cylinder_bank(bankB1)
        .add_cylinder_bank(bankB2)

    engine.add_crankshaft(c0)

    // Approximated cam spec (not from a published cam card) -- short
    // duration/modest lift, appropriate for a heavily boosted, low-NA-stress
    // head.
    harmonic_cam_lobe intake_lobe(
        duration_at_50_thou: 202 * units.deg,
        gamma: 1.05,
        lift: 8.6 * units.mm,
        steps: 100
    )

    harmonic_cam_lobe exhaust_lobe(
        duration_at_50_thou: 206 * units.deg,
        gamma: 1.05,
        lift: 8.2 * units.mm,
        steps: 100
    )

    w16_camshaft camshaft(
        lobe_profile: "N/A",
        intake_lobe_profile: intake_lobe,
        exhaust_lobe_profile: exhaust_lobe,
        intake_lobe_center: 112 * units.deg,
        exhaust_lobe_center: 112 * units.deg,
        base_radius: 0.68 * units.inch
    )

    function timing_curve(1000 * units.rpm)
    timing_curve
        .add_sample(0000 * units.rpm, 8 * units.deg)
        .add_sample(1000 * units.rpm, 12 * units.deg)
        .add_sample(2000 * units.rpm, 16 * units.deg)
        .add_sample(3000 * units.rpm, 19 * units.deg)
        .add_sample(4000 * units.rpm, 21 * units.deg)
        .add_sample(5000 * units.rpm, 21 * units.deg)
        .add_sample(6000 * units.rpm, 20 * units.deg)

    ignition_module ignition_module(
        timing_curve: timing_curve,
        rev_limit: 6600 * units.rpm,
        limiter_duration: 0.06
    )
    // Firing order 1-9-2-10-3-11-4-12-5-13-6-14-7-15-8-16, derived in the
    // file header.
    ignition_module
        .connect_wire(wires.wire1, (0.0 / 16.0) * cycle)
        .connect_wire(wires.wire9, (1.0 / 16.0) * cycle)
        .connect_wire(wires.wire2, (2.0 / 16.0) * cycle)
        .connect_wire(wires.wire10, (3.0 / 16.0) * cycle)
        .connect_wire(wires.wire3, (4.0 / 16.0) * cycle)
        .connect_wire(wires.wire11, (5.0 / 16.0) * cycle)
        .connect_wire(wires.wire4, (6.0 / 16.0) * cycle)
        .connect_wire(wires.wire12, (7.0 / 16.0) * cycle)
        .connect_wire(wires.wire5, (8.0 / 16.0) * cycle)
        .connect_wire(wires.wire13, (9.0 / 16.0) * cycle)
        .connect_wire(wires.wire6, (10.0 / 16.0) * cycle)
        .connect_wire(wires.wire14, (11.0 / 16.0) * cycle)
        .connect_wire(wires.wire7, (12.0 / 16.0) * cycle)
        .connect_wire(wires.wire15, (13.0 / 16.0) * cycle)
        .connect_wire(wires.wire8, (14.0 / 16.0) * cycle)
        .connect_wire(wires.wire16, (15.0 / 16.0) * cycle)

    engine.add_ignition_module(ignition_module)
}

private node veyron_w16_quad_turbo {
    alias output __out: base.turbo_engine;

    veyron_w16_na base()

    // Four small, quick-spooling turbos (real Veyron character -- boost
    // comes on fast rather than one or two large laggy units), each fed
    // only by its own bank's exhaust, all four compressors merging into
    // the shared intake plenum.
    turbocharger turbo0(
        intake: base.turbo_intake,
        turbine_flow_rate: k_carb(200.0),
        turbine_inertia: 0.00003,
        turbine_efficiency: 0.68,
        compressor_efficiency: 0.74,
        max_boost: 18.0 * units.psi,
        spool_speed: 170000.0 * units.rpm,
        spin_down_time: 0.5,
        bov_sound: bov_lib.bovaftermarket3
    )
    turbo0.add_exhaust_system(base.turbo_exhaust0)

    turbocharger turbo1(
        intake: base.turbo_intake,
        turbine_flow_rate: k_carb(200.0),
        turbine_inertia: 0.00003,
        turbine_efficiency: 0.68,
        compressor_efficiency: 0.74,
        max_boost: 18.0 * units.psi,
        spool_speed: 170000.0 * units.rpm,
        spin_down_time: 0.5,
        bov_sound: bov_lib.bovaftermarket3
    )
    turbo1.add_exhaust_system(base.turbo_exhaust1)

    turbocharger turbo2(
        intake: base.turbo_intake,
        turbine_flow_rate: k_carb(200.0),
        turbine_inertia: 0.00003,
        turbine_efficiency: 0.68,
        compressor_efficiency: 0.74,
        max_boost: 18.0 * units.psi,
        spool_speed: 170000.0 * units.rpm,
        spin_down_time: 0.5,
        bov_sound: bov_lib.bovaftermarket3
    )
    turbo2.add_exhaust_system(base.turbo_exhaust2)

    turbocharger turbo3(
        intake: base.turbo_intake,
        turbine_flow_rate: k_carb(200.0),
        turbine_inertia: 0.00003,
        turbine_efficiency: 0.68,
        compressor_efficiency: 0.74,
        max_boost: 18.0 * units.psi,
        spool_speed: 170000.0 * units.rpm,
        spin_down_time: 0.5,
        bov_sound: bov_lib.bovaftermarket3
    )
    turbo3.add_exhaust_system(base.turbo_exhaust3)

    base.turbo_engine
        .add_turbocharger(turbo0)
        .add_turbocharger(turbo1)
        .add_turbocharger(turbo2)
        .add_turbocharger(turbo3)
}

// Veyron 16.4 -- Haldex-based permanent AWD, treated here as a single
// driveline (no front/rear torque split modeled), same approach as
// vr6.mr/w8.mr.
private node veyron_vehicle {
    alias output __out:
        vehicle(
            mass: 4400 * units.lb,
            drag_coefficient: 0.36, // high for a hypercar -- real Veyron prioritizes stability/cooling over Cd
            cross_sectional_area: (78 * units.inch) * (46 * units.inch),
            diff_ratio: 3.2, // approximate -- combined final drive, AWD simplification
            tire_radius: 13.0 * units.inch,
            rolling_resistance: 520 * units.N
        );
}

// 7-speed DSG-style dual-clutch (Ricardo-built, unique to the Veyron --
// there is no manual gearbox option on this car). Approximated ratios.
private node veyron_transmission {
    alias output __out:
        transmission(
            max_clutch_torque: 1050 * units.lb_ft,
            type: "dual_clutch",
            has_sport_mode: true,
            allow_manual_shift: true,
            shift_up_rpm_closed_throttle: 2500 * units.rpm,
            shift_up_rpm_wot: 6500 * units.rpm,
            shift_down_rpm_closed_throttle: 1200 * units.rpm,
            shift_down_rpm_wot: 3600 * units.rpm,
            sport_shift_up_rpm_closed_throttle: 3800 * units.rpm,
            sport_shift_up_rpm_wot: 6600 * units.rpm,
            sport_shift_down_rpm_closed_throttle: 2000 * units.rpm,
            sport_shift_down_rpm_wot: 4200 * units.rpm,
            shift_time_drive: 0.15,
            shift_time_sport: 0.08,
            shift_torque_cut: 0.15
        )
        .add_gear(3.150) // 1
        .add_gear(2.400) // 2
        .add_gear(1.950) // 3
        .add_gear(1.550) // 4
        .add_gear(1.250) // 5
        .add_gear(1.020) // 6
        .add_gear(0.820); // 7
}

public node main {
    set_engine(veyron_w16_quad_turbo())
    set_vehicle(veyron_vehicle())
    set_transmission(veyron_transmission())
}
